-- ── Utilities ─────────────────────────────────────────────────────────────
local function GetTextSize(text, size, font)
    return TextService:GetTextSize(text, size, font, Vector2.new(math.huge, math.huge))
end

local function Tween(obj, tweenInfo, props)
    TweenService:Create(obj, tweenInfo, props):Play()
end

local function NewTweenInfo(duration, style, direction, repeatCount, reverse, delay)
    return TweenInfo.new(
        duration or 0.2,
        style or Enum.EasingStyle.Sine,
        direction or Enum.EasingDirection.InOut,
        repeatCount or 0,
        reverse or false,
        delay or 0
    )
end

