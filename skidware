                textBox.TextXAlignment = Enum.TextXAlignment.Left
                textBox.TextYAlignment = Enum.TextYAlignment.Top
                textBox.TextWrapped = true
            end

            -- Format filter
            local function filter()
                local txt = textBox.Text
                if format == "numbers" then
                    txt = txt:gsub("%D+", "")
                elseif format == "lower" then
                    txt = txt:lower()
                elseif format == "upper" then
                    txt = txt:upper()
                end
                textBox.Text = txt
            end
            textBox:GetPropertyChangedSignal("Text"):Connect(filter)

            textBox.Focused:Connect(function()
                Tween(inputFrame, NewTweenInfo(0.07), {BackgroundColor3 = Theme.Primary})
            end)
            textBox.FocusLost:Connect(function()
                Tween(inputFrame, NewTweenInfo(0.07), {BackgroundColor3 = Theme.InputBg})
            end)
            textBox.FocusLost:Connect(function(enter)
                if autoexec or enter then
                    callback(textBox.Text)
                end
            end)

