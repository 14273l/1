-- Date/time helpers
function Library:GetDay(type)  -- same as original
    local t = {
        word = "%A", short = "%a", month = "%d", year = "%j"
    }
    return os.date(t[type] or "%A")
end
function Library:GetTime(type)
    local t = {
        ["24h"] = "%H", ["12h"] = "%I", minute = "%M", half = "%p",
        second = "%S", full = "%X", ISO = "%z", zone = "%Z"
    }
    return os.date(t[type] or "%X")
end
function Library:GetMonth(type)
    local t = { word = "%B", short = "%b", digit = "%m" }
    return os.date(t[type] or "%B")
end
function Library:GetWeek(type)
    local t = { year_S = "%U", day = "%w", year_M = "%W" }
    return os.date(t[type] or "%U")
end
function Library:GetYear(type)
    local t = { digits = "%y", full = "%Y" }
    return os.date(t[type] or "%Y")
end

-- ── Watermark ──────────────────────────────────────────────────────────
local WatermarkInstance = nil

function Library:Watermark(text)
    if WatermarkInstance then WatermarkInstance:destroy() end

    local screen = Instance.new("ScreenGui")
    screen.Name = "watermark"
    screen.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 0, 0, 26)
    frame.Position = UDim2.new(0, 6, 0, 6)
    frame.BackgroundColor3 = Theme.Edge
    frame.BackgroundTransparency = 1
    frame.Parent = screen

    BuildCorner(frame)

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(0, 0, 0, 24)
    bg.Position = UDim2.new(0.5, 0, 0.5, 0)
    bg.AnchorPoint = Vector2.new(0.5, 0.5)
    bg.BackgroundColor3 = Theme.Background
    bg.BackgroundTransparency = 1
    bg.ClipsDescendants = true
    bg.Parent = frame
    BuildCorner(bg)
    BuildGradient(bg, Theme.Background, Theme.BackgroundDark)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 0, 0, 24)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Code
    label.Text = text or "xsx v3"
    label.TextColor3 = Theme.Text
    label.TextSize = 14
    label.TextTransparency = 1
    label.Parent = bg

    local textSize = GetTextSize(label.Text, label.TextSize, label.Font)
    label.Size = UDim2.new(0, textSize.X + 8, 0, 24)

    -- Animate in
    local tweenIn = NewTweenInfo(0.2)
    local tweenFast = NewTweenInfo(0.05)

    Tween(frame, tweenIn, {BackgroundTransparency = 0, Size = UDim2.new(0, textSize.X + 10, 0, 26)})
    Tween(bg, tweenIn, {BackgroundTransparency = 0, Size = UDim2.new(0, textSize.X + 8, 0, 24)})
    task.wait(0.2)
    Tween(label, tweenIn, {TextTransparency = 0})

    local self = {
        _frame = frame,
        _bg = bg,
        _label = label,
        _screen = screen,
    }

    function self:setText(newText)
        newText = newText or "xsx v3"
        self._label.Text = newText
        local newSize = GetTextSize(newText, self._label.TextSize, self._label.Font)
        self._label.Size = UDim2.new(0, newSize.X + 8, 0, 24)
        -- animate resize
        Tween(self._frame, tweenFast, {Size = UDim2.new(0, newSize.X + 10, 0, 26)})
        Tween(self._bg, tweenFast, {Size = UDim2.new(0, newSize.X + 8, 0, 24)})
        return self
    end

    function self:show()
        self._frame.Visible = true
        return self
    end

    function self:hide()
        self._frame.Visible = false
        return self
    end

    function self:destroy()
        self._screen:Destroy()
        WatermarkInstance = nil
    end

    WatermarkInstance = self
    return self
end

-- ── Notifications ──────────────────────────────────────────────────────
local NotificationManager = nil

function Library:InitNotifications()
    if NotificationManager then NotificationManager._screen:Destroy() end

    local screen = Instance.new("ScreenGui")
    screen.Name = "Notifications"
    screen.Parent = CoreGui
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local list = Instance.new("UIListLayout")
    list.Parent = screen
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 4)

    local padding = Instance.new("UIPadding")
    padding.Parent = screen
    padding.PaddingLeft = UDim.new(0, 6)
    padding.PaddingTop = UDim.new(0, 18)

    local manager = {
        _screen = screen,
        _list = list,
    }

    function manager:notify(text, duration, type, callback)
        text = text or "please wait."
        duration = duration or 5
        type = type or "notification"
        callback = callback or function() end

        local colors = {
            notification = Color3.fromRGB(159, 115, 255),
            alert = Color3.fromRGB(255, 246, 112),
            error = Color3.fromRGB(255, 74, 77),
            success = Color3.fromRGB(131, 255, 103),
            information = Color3.fromRGB(126, 117, 255),
        }
        local barColor = colors[type] or colors.notification

        -- Build notification
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 0, 0, 26)
        frame.BackgroundColor3 = Theme.Edge
        frame.BackgroundTransparency = 1
        frame.Parent = screen

        BuildCorner(frame)

        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(0, 0, 0, 24)
        bg.Position = UDim2.new(0.5, 0, 0.5, 0)
        bg.AnchorPoint = Vector2.new(0.5, 0.5)
        bg.BackgroundColor3 = Theme.Background
        bg.BackgroundTransparency = 1
        bg.ClipsDescendants = true
        bg.Parent = frame
        BuildCorner(bg)
        BuildGradient(bg, Theme.Background, Theme.BackgroundDark)

        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(0, 0, 0, 1)
        bar.BackgroundColor3 = barColor
        bar.BackgroundTransparency = 0.2
        bar.Parent = bg
        BuildCorner(bar)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 230, 0, 26)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Code
        label.Text = text
        label.TextColor3 = Theme.Text
        label.TextSize = 14
        label.TextTransparency = 1
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.RichText = true
        label.Parent = bg

        local textSize = GetTextSize(label.Text, label.TextSize, label.Font)
        label.Size = UDim2.new(0, textSize.X + 8, 0, 26)

        -- Animate in
        local tweenIn = NewTweenInfo(0.2)
        Tween(frame, tweenIn, {BackgroundTransparency = 0, Size = UDim2.new(0, textSize.X + 10, 0, 26)})
        Tween(bg, tweenIn, {BackgroundTransparency = 0, Size = UDim2.new(0, textSize.X + 8, 0, 24)})
        Tween(label, tweenIn, {TextTransparency = 0})
        task.wait(0.1)

        -- Progress bar tween
        local tweenDuration = NewTweenInfo(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        Tween(bar, tweenDuration, {Size = UDim2.new(0, textSize.X + 8, 0, 1)})

        -- Wait for bar to complete, then fade out
        local barComplete = false
        bar:GetPropertyChangedSignal("Size"):Connect(function()
            if bar.Size.X.Offset >= textSize.X + 8 then
                barComplete = true
            end
        end)

        -- Also allow a fallback timer
        task.spawn(function()
            task.wait(duration + 0.5)
            if not barComplete then
                bar.Size = UDim2.new(0, textSize.X + 8, 0, 1)
                barComplete = true
            end
        end)

        -- Wait for completion
        repeat task.wait() until barComplete

        -- Fade out and destroy
        local tweenOut = NewTweenInfo(0.2)
        Tween(frame, tweenOut, {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 26)})
        Tween(bg, tweenOut, {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 24)})
        Tween(label, tweenOut, {TextTransparency = 1})
        Tween(bar, tweenOut, {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 1)})
        task.wait(0.3)
        frame:Destroy()
        callback()
        return manager
    end

    function manager:destroy()
        self._screen:Destroy()
        NotificationManager = nil
    end

    NotificationManager = manager
    return manager
end

