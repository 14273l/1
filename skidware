            optionList.HorizontalAlignment = Enum.HorizontalAlignment.Center
            optionList.SortOrder = Enum.SortOrder.LayoutOrder

            local options = {}
            local selected = default or ". . ."

            local function buildOptions()
                for _, v in ipairs(list) do
                    local opt = Instance.new("TextButton")
                    opt.Size = UDim2.new(1, 0, 0, 20)
                    opt.BackgroundTransparency = 1
                    opt.AutoButtonColor = false
                    opt.Font = Enum.Font.Code
                    opt.Text = v
                    opt.TextColor3 = (v == selected) and Theme.Primary or Theme.Text
                    opt.TextSize = 14
                    opt.Parent = optionContainer
                    opt.MouseButton1Click:Connect(function()
                        selected = v
                        selectedLabel.Text = v
                        -- update colors
                        for _, child in ipairs(optionContainer:GetChildren()) do
                            if child:IsA("TextButton") then
                                child.TextColor3 = (child.Text == v) and Theme.Primary or Theme.Text
                            end
                        end
                        callback(v)
                        -- collapse
                        optionContainer.Size = UDim2.new(1, 0, 0, 0)
                        selectorBg.Size = UDim2.new(1, -2, 0, 20)
                        selectorBtn.Size = UDim2.new(1, 0, 0, 21)
                        row.Size = UDim2.new(0, 396, 0, 46)
                    end)
                    table.insert(options, opt)
                end
                local count = #list
                optionContainer.Size = UDim2.new(1, 0, 0, count * 20)
                selectorBg.Size = UDim2.new(1, -2, 0, 20 + count * 20)
                selectorBtn.Size = UDim2.new(1, 0, 0, 21 + count * 20)
                row.Size = UDim2.new(0, 396, 0, 46 + count * 20)
            end
            buildOptions()

            local expanded = false
            selectorBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                if expanded then
                    local count = #list
                    optionContainer.Size = UDim2.new(1, 0, 0, count * 20)
                    selectorBg.Size = UDim2.new(1, -2, 0, 20 + count * 20)
                    selectorBtn.Size = UDim2.new(1, 0, 0, 21 + count * 20)
                    row.Size = UDim2.new(0, 396, 0, 46 + count * 20)
                else
                    optionContainer.Size = UDim2.new(1, 0, 0, 0)
                    selectorBg.Size = UDim2.new(1, -2, 0, 20)
                    selectorBtn.Size = UDim2.new(1, 0, 0, 21)
                    row.Size = UDim2.new(0, 396, 0, 46)
                end
            end)

            local self = { _row = row, _label = label, _selected = selectedLabel, _container = optionContainer }
            function self:setText(t) label.Text = t; return self end
            function self:setValue(v)
                selected = v
                selectedLabel.Text = v
                for _, child in ipairs(optionContainer:GetChildren()) do
                    if child:IsA("TextButton") then
                        child.TextColor3 = (child.Text == v) and Theme.Primary or Theme.Text
                    end
                end
                callback(v)
                return self
            end
            function self:addOption(opt)
                table.insert(list, opt)
                -- rebuild options
                for _, child in ipairs(optionContainer:GetChildren()) do child:Destroy() end
                buildOptions()
                return self
            end
            function self:removeOption(opt)
                for i, v in ipairs(list) do
                    if v == opt then
                        table.remove(list, i)
                        break
                    end
                end
                for _, child in ipairs(optionContainer:GetChildren()) do child:Destroy() end
                buildOptions()
                return self
            end
            function self:setVisible(v) row.Visible = v; return self end
            function self:destroy() row:Destroy() end
            return self
        end

