-- ── Drag Mixin ───────────────────────────────────────────────────────────
local function MakeDraggable(frame)
    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or
           input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

-- ── Component Base ──────────────────────────────────────────────────────
local Component = {}
Component.__index = Component

function Component.new(parent, className, props)
    local self = setmetatable({}, Component)
    self.instance = Instance.new(className)
    self.instance.Parent = parent
    for k, v in pairs(props or {}) do
        self.instance[k] = v
    end
    self._children = {}
    return self
end

function Component:addChild(child)
    table.insert(self._children, child)
    return child
end

function Component:setVisible(visible)
    self.instance.Visible = visible
    return self
end

function Component:destroy()
    for _, child in ipairs(self._children) do
        child:destroy()
    end
    self.instance:Destroy()
end

-- ── Helpers to build UI elements (saves duplication) ──────────────────
local function BuildGradient(parent, color1, color2, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, color1),
        ColorSequenceKeypoint.new(1, color2 or color1)
    })
    g.Rotation = rotation or 90
    g.Parent = parent
    return g
end

local function BuildCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 2)
    c.Parent = parent
    return c
end

