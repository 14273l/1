            BuildCorner(inputBg)
            BuildGradient(inputBg, Theme.Background, Theme.BackgroundDark)

            local textBox = Instance.new("TextBox")
            textBox.BackgroundTransparency = 1
            textBox.Font = Enum.Font.Code
            textBox.PlaceholderText = placeholder or ""
            textBox.Text = default or ""
            textBox.TextColor3 = Theme.Text
            textBox.TextSize = 14
            textBox.ClearTextOnFocus = autoclear
            textBox.Parent = inputBg

            if size == "small" then
                inputFrame.Size = UDim2.new(0, 133, 0, 22)
                inputFrame.Position = UDim2.new(1, -133, 0, 24)
                inputBg.Size = UDim2.new(0, 131, 0, 20)
