            valueLabel.Size = UDim2.new(0, 100, 0, 24)
            valueLabel.Position = UDim2.new(1, -100, 0, 0)
            valueLabel.BackgroundTransparency = 1
            valueLabel.Font = Enum.Font.Code
            valueLabel.Text = ""
            valueLabel.TextColor3 = Theme.TextDim
            valueLabel.TextSize = 14
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.Parent = row

            local sliderBtn = Instance.new("TextButton")
            sliderBtn.Size = UDim2.new(1, 0, 0, 16)
            sliderBtn.Position = UDim2.new(0, 0, 0, 24)
            sliderBtn.BackgroundColor3 = Theme.InputBg
            sliderBtn.AutoButtonColor = false
            sliderBtn.Text = ""
            sliderBtn.Parent = row
            BuildCorner(sliderBtn)

            local sliderBg = Instance.new("Frame")
            sliderBg.Size = UDim2.new(1, -2, 0, 14)
            sliderBg.Position = UDim2.new(0.5, 0, 0.5, 0)
            sliderBg.AnchorPoint = Vector2.new(0.5, 0.5)
            sliderBg.BackgroundColor3 = Theme.Background
            sliderBg.ClipsDescendants = true
            sliderBg.Parent = sliderBtn
            BuildCorner(sliderBg)
            BuildGradient(sliderBg, Theme.Background, Theme.BackgroundDark)

            local indicator = Instance.new("Frame")
            indicator.Size = UDim2.new(0, 0, 0, 12)
            indicator.BackgroundColor3 = Theme.Primary
            indicator.Parent = sliderBg
            BuildCorner(indicator)
            BuildGradient(indicator, Theme.Primary, Theme.PrimaryDark)

            local min = values.min or 0
            local max = values.max or 100
            local defaultVal = values.default or 0

            local function updateValue(val)
                local clamped = math.clamp(val, min, max)
                local percent = (clamped - min) / (max - min)
                local width = sliderBg.AbsoluteSize.X
                indicator.Size = UDim2.new(0, percent * width, 0, 12)
                if compare then
                    valueLabel.Text = clamped .. compareSign .. tostring(max) .. (suffix or "")
                else
                    valueLabel.Text = clamped .. (suffix or "")
                end
                callback(clamped)
                return clamped
            end

            updateValue(defaultVal)

            local dragging = false
            sliderBtn.MouseButton1Down:Connect(function()
                dragging = true
                local function updateMouse()
                    local pos = Mouse.X - sliderBg.AbsolutePosition.X
                    local width = sliderBg.AbsoluteSize.X
                    local percent = math.clamp(pos / width, 0, 1)
                    local val = min + (max - min) * percent
                    updateValue(val)
                end
                updateMouse()
                local moveConn, releaseConn
                moveConn = Mouse.Move:Connect(function()
                    if dragging then
                        updateMouse()
                    end
                end)
                releaseConn = UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                        moveConn:Disconnect()
                        releaseConn:Disconnect()
                    end
                end)
            end)

            local self = { _row = row, _label = label, _value = valueLabel, _indicator = indicator, _bg = sliderBg }
            function self:setValue(v)
                updateValue(v)
                return self
            end
            function self:setText(t) label.Text = t; return self end
            function self:setVisible(v) row.Visible = v; return self end
            function self:destroy() row:Destroy() end
            return self
        end

        -- Separator
        function Components:NewSeperator()
            local row = createRow(12)
            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, 0, 0, 1)
            bar.Position = UDim2.new(0, 0, 0.5, 0)
            bar.BackgroundColor3 = Theme.Edge
            bar.BorderSizePixel = 0
            bar.Parent = row
            local self = { _row = row }
            function self:setVisible(v) row.Visible = v; return self end
            function self:destroy() row:Destroy() end
            return self
        end

        -- Open tab programmatically
        function Components:Open()
            switchTab(title)
            return Components
        end

        -- Hide/Show tab button and page
        function Components:Hide()
            btn.Visible = false
            page.Visible = false
            return Components
        end
        function Components:Show()
            btn.Visible = true
            return Components
        end
        function Components:Remove()
            btn:Destroy()
            page:Destroy()
            return Components
        end
        function Components:Text(t)
            btn.Text = t
            return Components
        end

        return Components
    end

    -- Library UI methods
    function LibraryUI:Remove()
        screen:Destroy()
    end

    function LibraryUI:Text(t)
        header.Text = t
        return self
    end

    function LibraryUI:UpdateKeybind(newKey)
        -- we already handle key, but we can store it for future? Not needed
        return self
    end

    return LibraryUI
end

-- ── Public Init ──────────────────────────────────────────────────────
function Library:Init(key)
    return BuildMainUI(key)
end

-- ── Return Library ──────────────────────────────────────────────────
return Library
