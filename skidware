                inputBg.AnchorPoint = Vector2.new(0.5, 0.5)
                textBox.Size = UDim2.new(1, 0, 1, 0)
                textBox.TextXAlignment = Enum.TextXAlignment.Right
            elseif size == "medium" then
                inputFrame.Size = UDim2.new(1, 0, 0, 22)
                inputFrame.Position = UDim2.new(0, 0, 0, 24)
                inputBg.Size = UDim2.new(1, -2, 0, 20)
                inputBg.Position = UDim2.new(0.5, 0, 0.5, 0)
                inputBg.AnchorPoint = Vector2.new(0.5, 0.5)
                textBox.Size = UDim2.new(1, 0, 1, 0)
                textBox.TextXAlignment = Enum.TextXAlignment.Left
            else -- large
                inputFrame.Size = UDim2.new(1, 0, 0, rowHeight - 24)
                inputFrame.Position = UDim2.new(0, 0, 0, 24)
                inputBg.Size = UDim2.new(1, -2, 1, -2)
