        -- Button (single or multiple inline)
        function Components:NewButton(text, callback)
            local row = createRow(24)
            local container = Instance.new("Frame")
            container.Size = UDim2.new(1, 0, 1, 0)
            container.BackgroundTransparency = 1
            container.Parent = row

            local layout = Instance.new("UIListLayout")
            layout.FillDirection = Enum.FillDirection.Horizontal
            layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            layout.VerticalAlignment = Enum.VerticalAlignment.Center
            layout.Padding = UDim.new(0, 4)
            layout.Parent = container

            local buttons = {}
            local function addButton(txt, cb)
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(0, 396, 0, 24)
                btn.BackgroundColor3 = Theme.InputBg
                btn.AutoButtonColor = false
                btn.Text = ""
                btn.Parent = container

                local corner = BuildCorner(btn)
                local bg = Instance.new("Frame")
                bg.Size = UDim2.new(0, 394, 0, 22)
                bg.Position = UDim2.new(0.5, 0, 0.5, 0)
                bg.AnchorPoint = Vector2.new(0.5, 0.5)
                bg.BackgroundColor3 = Theme.Background
                bg.Parent = btn
                BuildCorner(bg)
                BuildGradient(bg, Theme.Background, Theme.BackgroundDark)

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.Code
                label.Text = txt
                label.TextColor3 = Theme.Text
                label.TextSize = 14
                label.RichText = true
                label.Parent = bg

                local btnData = { btn = btn, label = label, callback = cb }

                btn.MouseEnter:Connect(function()
                    Tween(btn, NewTweenInfo(0.16), {BackgroundColor3 = Theme.HoverBg})
                end)
                btn.MouseLeave:Connect(function()
                    Tween(btn, NewTweenInfo(0.16), {BackgroundColor3 = Theme.InputBg})
                end)
                btn.MouseButton1Down:Connect(function()
                    Tween(label, NewTweenInfo(0.16), {TextColor3 = Theme.Primary})
                end)
                btn.MouseButton1Up:Connect(function()
                    Tween(label, NewTweenInfo(0.16), {TextColor3 = Theme.Text})
                end)
                btn.MouseButton1Click:Connect(function()
                    if cb then cb() end
                end)

                table.insert(buttons, btnData)

                -- Recalculate sizes if more than 1 button
                local function resize()
                    local count = #buttons
                    if count == 0 then return end
                    local width = 396 / count - 4 * (count - 1)
                    for _, b in ipairs(buttons) do
                        b.btn.Size = UDim2.new(0, width, 0, 24)
                        local bg2 = b.btn:FindFirstChildWhichIsA("Frame")
                        if bg2 then
                            bg2.Size = UDim2.new(0, width - 2, 0, 22)
                        end
                    end
                end
                resize()
                return btnData
            end

            local first = addButton(text, callback)

            -- Return object with methods
            local self = {
                _row = row,
                _container = container,
                _buttons = buttons,
                _add = addButton,
            }

            function self:AddButton(txt, cb)
                if #buttons >= 4 then
                    warn("Max 4 buttons per row")
                    return self
                end
                self._add(txt, cb)
                return self
            end

            function self:setText(txt)
                if #buttons > 0 then
                    buttons[1].label.Text = txt
                end
                return self
            end

            function self:setVisible(v)
                row.Visible = v
                return self
            end

            function self:destroy()
                row:Destroy()
            end
            return self
        end

