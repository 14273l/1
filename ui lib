    createStroke(frame, Config.Colors.BorderDim, nil, nil, Enum.LineJoinMode.Miter)
    createPadding(frame, 5)
    
    local button = Instance.new("TextButton", frame)
    button.Text = default or label
    button.TextColor3 = Config.Colors.Text
    button.TextSize = 13
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.FontFace = createFont(Config.Font, Config.FontBold)
    button.Size = UDim2.new(0, 205, 0, 15)
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    button.AutomaticSize = Enum.AutomaticSize.Y
    
    local arrow = Instance.new("ImageLabel", frame)
    arrow.Image = "rbxassetid://15554886440"
    arrow.ImageColor3 = Color3.fromRGB(255, 254, 255)
    arrow.Size = UDim2.new(0, 25, 0, 25)
    arrow.Position = UDim2.new(0.895, 0, -0.455, 2)
    arrow.BackgroundTransparency = 1
    arrow.BorderSizePixel = 0
    
    -- Dropdown frame (will be repositioned)
    local dropdownFrame = Instance.new("Frame", self.Parent.Parent.Parent.Gui)
    dropdownFrame.Name = "dropdown frame"
    dropdownFrame.BackgroundColor3 = Config.Colors.Background
    dropdownFrame.Size = UDim2.new(0, 205, 0, 0)
    dropdownFrame.AutomaticSize = Enum.AutomaticSize.Y
    dropdownFrame.BorderSizePixel = 0
    dropdownFrame.Visible = false
    dropdownFrame.Position = UDim2.new(-0.43963, 0, -0.00121, 0)
    
    createStroke(dropdownFrame, Config.Colors.BorderDim)
    
    local padding = Instance.new("UIPadding", dropdownFrame)
    padding.PaddingTop = UDim.new(0, 5)
    padding.PaddingBottom = UDim.new(0, 5)
    
    local layout = Instance.new("UIListLayout", dropdownFrame)
    layout.Padding = UDim.new(0, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    local selectedOption = default
    local optionButtons = {}
    
    local function updateDropdownPosition()
        local absPos = frame.AbsolutePosition
        dropdownFrame.Position = UDim2.new(0, absPos.X, 0, absPos.Y + frame.AbsoluteSize.Y)
        dropdownFrame.Size = UDim2.new(0, frame.AbsoluteSize.X, 0, 0)
    end
    
    local function createOption(option)
        local optButton = Instance.new("TextButton", dropdownFrame)
        optButton.Name = (option == selectedOption) and "selection" or "unselected"
        optButton.Text = option
        optButton.TextColor3 = (option == selectedOption) and Config.Colors.Text or Config.Colors.TextDim
        optButton.TextSize = 14
        optButton.FontFace = createFont(Config.Font, Config.FontBold)
        optButton.Size = UDim2.new(1, 0, 0, 16)
        optButton.BackgroundColor3 = Config.Colors.Background
        optButton.BorderSizePixel = 0
        
        optButton.MouseButton1Click:Connect(function()
            selectedOption = option
            button.Text = option
            dropdownFrame.Visible = false
            
            -- Update colors
            for _, btn in ipairs(dropdownFrame:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.Name = (btn.Text == option) and "selection" or "unselected"
                    btn.TextColor3 = (btn.Text == option) and Config.Colors.Text or Config.Colors.TextDim
                end
            end
            
            if callback then callback(option) end
        end)
        
        return optButton
    end
    
    for _, option in ipairs(options) do
        createOption(option)
    end
    
    button.MouseButton1Click:Connect(function()
        dropdownFrame.Visible = not dropdownFrame.Visible
        if dropdownFrame.Visible then
            updateDropdownPosition()
        end
    end)
    
    return {
        SetOptions = function(newOptions)
            -- Clear existing options
            for _, child in ipairs(dropdownFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
            for _, option in ipairs(newOptions) do
                createOption(option)
            end
        end,
        GetSelected = function() return selectedOption end,
        SetSelected = function(option)
            selectedOption = option
            button.Text = option
            for _, btn in ipairs(dropdownFrame:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.Name = (btn.Text == option) and "selection" or "unselected"
                    btn.TextColor3 = (btn.Text == option) and Config.Colors.Text or Config.Colors.TextDim
                end
            end
            if callback then callback(option) end
        end
    }
end

function Section:AddSlider(label, min, max, default, callback)
    local frame = Instance.new("Frame", self.Frame)
    frame.Name = "slider"
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(0, 205, 0, 30)
    frame.BorderSizePixel = 0
    frame.AutomaticSize = Enum.AutomaticSize.Y
    
    createPadding(frame, nil, nil, nil, 4)
    
    local title = Instance.new("TextLabel", frame)
    title.Name = "Title"
    title.Text = label
    title.TextColor3 = Config.Colors.Text
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextYAlignment = Enum.TextYAlignment.Top
    title.FontFace = createFont(Config.Font, Config.FontBold)
    title.Size = UDim2.new(0, 205, 0, 15)
    title.BackgroundTransparency = 1
    title.BorderSizePixel = 0
    
    local sliderBase = Instance.new("Frame", frame)
    sliderBase.Name = "slider base"
    sliderBase.BackgroundTransparency = 1
    sliderBase.Size = UDim2.new(0, 205, 0, 15)
    sliderBase.Position = UDim2.new(0, 0, 0.59524, 0)
    sliderBase.BorderSizePixel = 0
    
    createStroke(sliderBase, Config.Colors.BorderDim)
    
    local fill = Instance.new("Frame", sliderBase)
    fill.Name = "slider fill"
    fill.BackgroundColor3 = Config.Colors.Primary
    fill.Size = UDim2.new(0, 0, 0, 15)
    fill.BorderSizePixel = 0
    fill.SizeConstraint = Enum.SizeConstraint.RelativeXX
    
    createShadow(fill, Config.Colors.Primary, 0.5, 0, 8)
    
    local valueLabel = Instance.new("TextLabel", sliderBase)
    valueLabel.Text = tostring(default or min) .. "px"
    valueLabel.TextColor3 = Config.Colors.Text
    valueLabel.TextSize = 14
    valueLabel.FontFace = createFont(Config.Font, Config.FontRegular)
    valueLabel.Size = UDim2.new(0, 205, 0, 15)
    valueLabel.ZIndex = 2
    valueLabel.BackgroundTransparency = 1
    valueLabel.BorderSizePixel = 0
    
    local currentValue = default or min
    
    local function updateSlider(value)
        local clamped = math.clamp(value, min, max)
        currentValue = clamped
        local percent = (clamped - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 0, 15)
        valueLabel.Text = math.round(clamped) .. "px"
        if callback then callback(clamped) end
    end
    
    updateSlider(currentValue)
    
    local dragging = false
    
    sliderBase.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    sliderBase.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    sliderBase.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = input.Position.X - sliderBase.AbsolutePosition.X
            local percent = math.clamp(pos / sliderBase.AbsoluteSize.X, 0, 1)
            local value = min + (max - min) * percent
            updateSlider(value)
        end
    end)
    
    return {
        Set = function(value)
            updateSlider(value)
        end,
        Get = function()
            return currentValue
        end
    }
end

