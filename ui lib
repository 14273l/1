local Library = {}
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

function Library:CreateWindow(titleText)
    local Window = {}
    
    local ScreenGui = Instance.new("ScreenGui", PlayerGui)
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Name = "AkariPrivateUI"

    local WindowFrame = Instance.new("Frame", ScreenGui)
    WindowFrame.BorderSizePixel = 0
    WindowFrame.BackgroundColor3 = Color3.fromRGB(17, 16, 17)
    WindowFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    WindowFrame.Size = UDim2.new(0, 498, 0, 598)
    WindowFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    WindowFrame.BorderColor3 = Color3.fromRGB(0, 0, 0)
    WindowFrame.Name = "window"

    local Stroke1 = Instance.new("UIStroke", WindowFrame)
    Stroke1.Color = Color3.fromRGB(174, 189, 245)
    Stroke1.LineJoinMode = Enum.LineJoinMode.Miter

    local Stroke2 = Instance.new("UIStroke", WindowFrame)
    Stroke2.BorderOffset = UDim.new(0, 1)
    Stroke2.LineJoinMode = Enum.LineJoinMode.Miter

    local TitleFrame = Instance.new("Frame", WindowFrame)
    TitleFrame.BorderSizePixel = 0
    TitleFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TitleFrame.Size = UDim2.new(1, 0, 0, 29)
    TitleFrame.BackgroundTransparency = 1
    TitleFrame.Name = "title"

    local TitleLabel = Instance.new("TextLabel", TitleFrame)
    TitleLabel.BorderSizePixel = 0
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.RichText = true
    TitleLabel.Size = UDim2.new(1, 0, 1, 0)
    TitleLabel.Text = titleText or ' <font color="rgb(169, 189, 249)">akari</font>.private'

    local TitleStroke = Instance.new("UIStroke", TitleLabel)
    TitleStroke.BorderOffset = UDim.new(0, 1)
    TitleStroke.LineJoinMode = Enum.LineJoinMode.Miter

    local TitlePadding = Instance.new("UIPadding", TitleFrame)
    TitlePadding.PaddingLeft = UDim.new(0, 9)

    local TabButtons = Instance.new("Frame", WindowFrame)
    TabButtons.ZIndex = 2
    TabButtons.BorderSizePixel = 0
    TabButtons.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
    TabButtons.Size = UDim2.new(1, -18, 0, 25)
    TabButtons.Position = UDim2.new(0, 9, 0, 29)
    TabButtons.Name = "tab_buttons"

    local TabListLayout = Instance.new("UIListLayout", TabButtons)
    TabListLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
    TabListLayout.Padding = UDim.new(0, 1)
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.FillDirection = Enum.FillDirection.Horizontal

    local TabPadding = Instance.new("UIPadding", TabButtons)
    TabPadding.PaddingRight = UDim.new(0, 1)
    TabPadding.PaddingLeft = UDim.new(0, 1)

    local TabContainer = Instance.new("Frame", WindowFrame)
    TabContainer.BorderSizePixel = 0
    TabContainer.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
    TabContainer.Size = UDim2.new(1, -20, 1, -54)
    TabContainer.Position = UDim2.new(0, 10, 0, 54)
    TabContainer.Name = "tab"

    local TabContainerStroke = Instance.new("UIStroke", TabContainer)
    TabContainerStroke.Color = Color3.fromRGB(41, 41, 41)
    TabContainerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    TabContainerStroke.LineJoinMode = Enum.LineJoinMode.Miter

    local TabContainerPadding = Instance.new("UIPadding", TabContainer)
    TabContainerPadding.PaddingTop = UDim.new(0, 12)
    TabContainerPadding.PaddingRight = UDim.new(0, 11)
    TabContainerPadding.PaddingLeft = UDim.new(0, 11)

    local TabContainerLayout = Instance.new("UIListLayout", TabContainer)
    TabContainerLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
    TabContainerLayout.Padding = UDim.new(0, 12)
    TabContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabContainerLayout.FillDirection = Enum.FillDirection.Horizontal

    local WindowPadding = Instance.new("UIPadding", WindowFrame)
    WindowPadding.PaddingBottom = UDim.new(0, 10)

    -- Draggable functionality
    local dragging, dragInput, dragStart, startPos
    TitleFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = WindowFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    RunService.RenderStepped:Connect(function()
        if dragging and dragInput then
            local delta = dragInput.Position - dragStart
            WindowFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local tabs = {}
    local firstTab = true

    function Window:CreateTab(tabName)
        local Tab = {}

        local TabButton = Instance.new("TextButton", TabButtons)
        TabButton.BorderSizePixel = 0
        TabButton.TextSize = 14
        TabButton.TextColor3 = firstTab and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(121, 121, 120)
        TabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
        TabButton.BackgroundTransparency = 1
        TabButton.Size = UDim2.new(1, 0, 1, 0)
        TabButton.Text = tabName

        local Highlight = Instance.new("Frame", TabButton)
        Highlight.BorderSizePixel = 0
        Highlight.BackgroundColor3 = Color3.fromRGB(155, 173, 227)
        Highlight.Size = UDim2.new(1, 0, 0, 2)
        Highlight.Visible = firstTab
        Highlight.Name = "highlight"

        Instance.new("UIShadow", Highlight)

        local StrokeA = Instance.new("UIStroke", TabButton)
        StrokeA.LineJoinMode = Enum.LineJoinMode.Miter

        local StrokeB = Instance.new("UIStroke", TabButton)
        StrokeB.Color = Color3.fromRGB(41, 41, 41)
        StrokeB.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        StrokeB.LineJoinMode = Enum.LineJoinMode.Miter

        local Underline = Instance.new("Frame", TabButton)
        Underline.BorderSizePixel = 0
        Underline.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
        Underline.Size = UDim2.new(1, 0, 0, 1)
        Underline.Position = UDim2.new(0, 0, 1, 0)
        Underline.Visible = firstTab

        local SectionParent = Instance.new("Frame", TabContainer)
        SectionParent.BorderSizePixel = 0
        SectionParent.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
        SectionParent.AutomaticSize = Enum.AutomaticSize.Y
        SectionParent.Size = UDim2.new(0, 223, 0, 0)
        SectionParent.Visible = firstTab
        SectionParent.Name = "section"

        Instance.new("UIStroke", SectionParent).BorderOffset = UDim.new(0, 1)
        local SectionStroke = Instance.new("UIStroke", SectionParent)
        SectionStroke.Color = Color3.fromRGB(71, 71, 71)

        local SectionLayout = Instance.new("UIListLayout", SectionParent)
        SectionLayout.Padding = UDim.new(0, 12)
        SectionLayout.SortOrder = Enum.SortOrder.LayoutOrder

        local SectionPadding = Instance.new("UIPadding", SectionParent)
        SectionPadding.PaddingTop = UDim.new(0, 10)
        SectionPadding.PaddingLeft = UDim.new(0.0225, 0)
        SectionPadding.PaddingBottom = UDim.new(0, 10)

        table.insert(tabs, {
            Button = TabButton,
            Highlight = Highlight,
            Underline = Underline,
            Section = SectionParent
        })

        local currentTabObj = tabs[#tabs]
        TabButton.MouseButton1Click:Connect(function()
            for _, t in ipairs(tabs) do
                t.Highlight.Visible = false
                t.Underline.Visible = false
                t.Section.Visible = false
                t.Button.TextColor3 = Color3.fromRGB(121, 121, 120)
            end
            currentTabObj.Highlight.Visible = true
            currentTabObj.Underline.Visible = true
            currentTabObj.Section.Visible = true
            currentTabObj.Button.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)

        firstTab = false

        function Tab:CreateToggle(toggleText, default, callback)
            callback = callback or function() end
            default = default or false

            local ToggleFrame = Instance.new("Frame", SectionParent)
            ToggleFrame.BorderSizePixel = 0
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            ToggleFrame.Size = UDim2.new(0, 0, 0, 16)
            ToggleFrame.BackgroundTransparency = 1

            local ToggleBtn = Instance.new("TextButton", ToggleFrame)
            ToggleBtn.BorderSizePixel = 0
            ToggleBtn.BackgroundColor3 = default and Color3.fromRGB(174, 189, 245) or Color3.fromRGB(24, 24, 24)
            ToggleBtn.Size = UDim2.new(0, 10, 0, 10)
            ToggleBtn.Text = ""
            ToggleBtn.Position = UDim2.new(0, 0, 0.5, 0)

            if default then
                Instance.new("UIShadow", ToggleBtn)
            end

            local ts1 = Instance.new("UIStroke", ToggleBtn)
            ts1.Color = Color3.fromRGB(71, 71, 71)
            ts1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

            local ts2 = Instance.new("UIStroke", ToggleBtn)
            ts2.BorderOffset = UDim.new(0, 1)
            ts2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

            local tList = Instance.new("UIListLayout", ToggleFrame)
            tList.Padding = UDim.new(0, 7)
            tList.VerticalAlignment = Enum.VerticalAlignment.Center
            tList.FillDirection = Enum.FillDirection.Horizontal

            local tLabel = Instance.new("TextLabel", ToggleFrame)
            tLabel.TextStrokeTransparency = 0
            tLabel.BorderSizePixel = 0
            tLabel.TextSize = 14
            tLabel.TextXAlignment = Enum.TextXAlignment.Left
            tLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            tLabel.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            tLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            tLabel.BackgroundTransparency = 1
            tLabel.Size = UDim2.new(1, 0, 1, 0)
            tLabel.Text = toggleText

            local state = default
            ToggleBtn.MouseButton1Click:Connect(function()
                state = not state
                ToggleBtn.BackgroundColor3 = state and Color3.fromRGB(174, 189, 245) or Color3.fromRGB(24, 24, 24)
                if state then
                    if not ToggleBtn:FindFirstChildOfClass("UIShadow") then
                        Instance.new("UIShadow", ToggleBtn)
                    end
                else
                    local shadow = ToggleBtn:FindFirstChildOfClass("UIShadow")
                    if shadow then shadow:Destroy() end
                end
                callback(state)
            end)

            tLabel.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    ToggleBtn.MouseButton1Click:Fire()
                end
            end)
        end

        function Tab:CreateButton(buttonText, callback)
            callback = callback or function() end

            local BtnFrame = Instance.new("Frame", SectionParent)
            BtnFrame.BorderSizePixel = 0
            BtnFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            BtnFrame.Size = UDim2.new(0, 205, 0, 15)
            BtnFrame.BackgroundTransparency = 1

            local Stroke = Instance.new("UIStroke", BtnFrame)
            Stroke.Color = Color3.fromRGB(66, 66, 66)

            local Padding = Instance.new("UIPadding", BtnFrame)
            Padding.PaddingLeft = UDim.new(0, 5)

            local Button = Instance.new("TextButton", BtnFrame)
            Button.TextStrokeTransparency = 0
            Button.BorderSizePixel = 0
            Button.TextXAlignment = Enum.TextXAlignment.Left
            Button.TextSize = 13
            Button.TextColor3 = Color3.fromRGB(255, 255, 255)
            Button.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Button.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
            Button.BackgroundTransparency = 1
            Button.Size = UDim2.new(0, 205, 0, 15)
            Button.Text = buttonText

            Button.MouseButton1Click:Connect(function()
                callback()
            end)
        end

        function Tab:CreateSlider(sliderText, min, max, default, callback)
            callback = callback or function() end
            min = min or 0
            max = max or 100
            default = default or min

            local SliderFrame = Instance.new("Frame", SectionParent)
            SliderFrame.BorderSizePixel = 0
            SliderFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            SliderFrame.Size = UDim2.new(0, 205, 0, 30)
            SliderFrame.BackgroundTransparency = 1

            local SPadding = Instance.new("UIPadding", SliderFrame)
            SPadding.PaddingBottom = UDim.new(0, 4)

            local SBase = Instance.new("Frame", SliderFrame)
            SBase.BorderSizePixel = 0
            SBase.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            SBase.Size = UDim2.new(0, 205, 0, 15)
            SBase.Position = UDim2.new(0, 0, 0.595, 0)
            SBase.BackgroundTransparency = 1

            local SStroke = Instance.new("UIStroke", SBase)
            SStroke.Color = Color3.fromRGB(66, 66, 66)

            local SValLabel = Instance.new("TextLabel", SBase)
            SValLabel.TextStrokeTransparency = 0
            SValLabel.ZIndex = 2
            SValLabel.BorderSizePixel = 0
            SValLabel.TextSize = 14
            SValLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            SValLabel.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            SValLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            SValLabel.BackgroundTransparency = 1
            SValLabel.Size = UDim2.new(0, 205, 0, 15)
            SValLabel.Text = tostring(default)

            local SFill = Instance.new("Frame", SBase)
            SFill.SizeConstraint = Enum.SizeConstraint.RelativeXX
            SFill.BorderSizePixel = 0
            SFill.BackgroundColor3 = Color3.fromRGB(173, 188, 244)
            SFill.Size = UDim2.new(0, ((default - min) / (max - min)) * 205, 0, 15)
            Instance.new("UIShadow", SFill)

            local STitle = Instance.new("TextLabel", SliderFrame)
            STitle.TextStrokeTransparency = 0
            STitle.BorderSizePixel = 0
            STitle.TextSize = 14
            STitle.TextXAlignment = Enum.TextXAlignment.Left
            STitle.TextYAlignment = Enum.TextYAlignment.Top
            STitle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            STitle.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
            STitle.TextColor3 = Color3.fromRGB(255, 255, 255)
            STitle.BackgroundTransparency = 1
            STitle.Size = UDim2.new(0, 205, 0, 15)
            STitle.Text = sliderText

            local sliding = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - SBase.AbsolutePosition.X) / SBase.AbsoluteSize.X, 0, 1)
                local val = math.floor(min + ((max - min) * pos))
                SFill.Size = UDim2.new(0, pos * 205, 0, 15)
                SValLabel.Text = tostring(val)
                callback(val)
            end

            SBase.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
        end

        function Tab:CreateKeybind(keybindText, defaultKey, callback)
            callback = callback or function() end
            defaultKey = defaultKey or Enum.KeyCode.F

            local KeyFrame = Instance.new("Frame", SectionParent)
            KeyFrame.BorderSizePixel = 0
            KeyFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            KeyFrame.Size = UDim2.new(0, 0, 0, 16)
            KeyFrame.BackgroundTransparency = 1

            local ToggleBtn = Instance.new("TextButton", KeyFrame)
            ToggleBtn.BorderSizePixel = 0
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
            ToggleBtn.Size = UDim2.new(0, 10, 0, 10)
            ToggleBtn.Text = ""
            ToggleBtn.Position = UDim2.new(0, 0, 0.5, 0)

            local ks1 = Instance.new("UIStroke", ToggleBtn)
            ks1.Color = Color3.fromRGB(71, 71, 71)
            ks1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

            local ks2 = Instance.new("UIStroke", ToggleBtn)
            ks2.BorderOffset = UDim.new(0, 1)
            ks2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

            local kList = Instance.new("UIListLayout", KeyFrame)
            kList.Padding = UDim.new(0, 7)
            kList.VerticalAlignment = Enum.VerticalAlignment.Center
            kList.FillDirection = Enum.FillDirection.Horizontal

            local kLabel = Instance.new("TextLabel", KeyFrame)
            kLabel.TextStrokeTransparency = 0
            kLabel.BorderSizePixel = 0
            kLabel.TextSize = 14
            kLabel.TextXAlignment = Enum.TextXAlignment.Left
            kLabel.TextYAlignment = Enum.TextYAlignment.Top
            kLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            kLabel.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            kLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            kLabel.BackgroundTransparency = 1
            kLabel.Size = UDim2.new(1, 0, 1, 0)
            kLabel.Text = keybindText

            local kVal = Instance.new("TextLabel", KeyFrame)
            kVal.TextStrokeTransparency = 0
            kVal.BorderSizePixel = 0
            kVal.TextSize = 12
            kVal.TextXAlignment = Enum.TextXAlignment.Right
            kVal.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            kVal.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
            kVal.TextColor3 = Color3.fromRGB(91, 91, 91)
            kVal.BackgroundTransparency = 1
            kVal.Size = UDim2.new(0, 185, 0, 15)
            kVal.Position = UDim2.new(24, 0, 0.031, 0)
            kVal.Text = "[" .. defaultKey.Name .. "]"

            local selectedKey = defaultKey
            local binding = false

            kVal.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    binding = true
                    kVal.Text = "[...]"
                end
            end)

            UserInputService.InputBegan:Connect(function(input)
                if binding then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        selectedKey = input.KeyCode
                        kVal.Text = "[" .. selectedKey.Name .. "]"
                        binding = false
                    end
                elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == selectedKey then
                    callback(selectedKey)
                end
            end)
        end

        return Tab
    end

    return Window
end

