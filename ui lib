local Library = {}
Library.__index = Library

-- Helper function to make frames draggable
local function makeDraggable(topbar, frame)
	local UserInputService = game:GetService("UserInputService")
	local dragging, dragInput, dragStart, startPos

	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	topbar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

function Library.CreateWindow(titleText)
	local windowData = {
		Tabs = {},
		CurrentTab = nil
	}

	-- ScreenGui
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

	-- Main Window Frame
	local Window = Instance.new("Frame", ScreenGui)
	Window.Name = "window"
	Window.BorderSizePixel = 0
	Window.BackgroundColor3 = Color3.fromRGB(17, 16, 17)
	Window.AnchorPoint = Vector2.new(0.5, 0.5)
	Window.Size = UDim2.new(0, 498, 0, 598)
	Window.Position = UDim2.new(0.5, 0, 0.5, 0)

	local Stroke1 = Instance.new("UIStroke", Window)
	Stroke1.Color = Color3.fromRGB(174, 189, 245)
	Stroke1.LineJoinMode = Enum.LineJoinMode.Miter

	local Stroke2 = Instance.new("UIStroke", Window)
	Stroke2.BorderOffset = UDim.new(0, 1)
	Stroke2.LineJoinMode = Enum.LineJoinMode.Miter

	local Padding = Instance.new("UIPadding", Window)
	Padding.PaddingBottom = UDim.new(0, 10)

	-- Title Bar
	local Title = Instance.new("Frame", Window)
	Title.Name = "title"
	Title.BorderSizePixel = 0
	Title.BackgroundTransparency = 1
	Title.Size = UDim2.new(1, 0, 0, 29)

	local TitleText = Instance.new("TextLabel", Title)
	TitleText.BorderSizePixel = 0
	TitleText.TextSize = 14
	TitleText.TextXAlignment = Enum.TextXAlignment.Left
	TitleText.BackgroundTransparency = 1
	TitleText.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	TitleText.TextColor3 = Color3.fromRGB(255, 255, 255)
	TitleText.RichText = true
	TitleText.Size = UDim2.new(1, 0, 1, 0)
	TitleText.Text = titleText or ' <font color="rgb(169, 189, 249)">akari</font>.private'

	local TitleStroke = Instance.new("UIStroke", TitleText)
	TitleStroke.BorderOffset = UDim.new(0, 1)
	TitleStroke.LineJoinMode = Enum.LineJoinMode.Miter

	local TitlePadding = Instance.new("UIPadding", Title)
	TitlePadding.PaddingLeft = UDim.new(0, 9)

	makeDraggable(Title, Window)

	-- Tab Buttons Container
	local TabButtons = Instance.new("Frame", Window)
	TabButtons.Name = "tab_buttons"
	TabButtons.ZIndex = 2
	TabButtons.BorderSizePixel = 0
	TabButtons.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
	TabButtons.Size = UDim2.new(1, -18, 0, 25)
	TabButtons.Position = UDim2.new(0, 9, 0, 29)

	local TabListLayout = Instance.new("UIListLayout", TabButtons)
	TabListLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
	TabListLayout.Padding = UDim.new(0, 1)
	TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	TabListLayout.FillDirection = Enum.FillDirection.Horizontal

	local TabButtonsPadding = Instance.new("UIPadding", TabButtons)
	TabButtonsPadding.PaddingRight = UDim.new(0, 1)
	TabButtonsPadding.PaddingLeft = UDim.new(0, 1)

	-- Tabs Content Frame
	local TabContainer = Instance.new("Frame", Window)
	TabContainer.Name = "tab_container"
	TabContainer.BorderSizePixel = 0
	TabContainer.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
	TabContainer.Size = UDim2.new(1, -20, 1, -54)
	TabContainer.Position = UDim2.new(0, 10, 0, 54)

	local TabContainerStroke = Instance.new("UIStroke", TabContainer)
	TabContainerStroke.Color = Color3.fromRGB(41, 41, 41)
	TabContainerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	TabContainerStroke.LineJoinMode = Enum.LineJoinMode.Miter

	-- Window Library API
	function windowData:CreateTab(tabName)
		local tabData = {}

		-- Create Tab Button
		local TabButton = Instance.new("TextButton", TabButtons)
		TabButton.Name = "tab_btn_" .. tabName
		TabButton.BorderSizePixel = 0
		TabButton.TextSize = 14
		TabButton.Text = tabName
		TabButton.TextColor3 = Color3.fromRGB(121, 121, 120)
		TabButton.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
		TabButton.BackgroundTransparency = 1
		TabButton.Size = UDim2.new(1, 0, 1, 0)

		local TabStroke1 = Instance.new("UIStroke", TabButton)
		TabStroke1.Color = Color3.fromRGB(41, 41, 41)
		TabStroke1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		TabStroke1.LineJoinMode = Enum.LineJoinMode.Miter

		local TabStroke2 = Instance.new("UIStroke", TabButton)
		TabStroke2.LineJoinMode = Enum.LineJoinMode.Miter

		-- Highlight Line for active tab
		local Highlight = Instance.new("Frame", TabButton)
		Highlight.Name = "selected_tab_highlight"
		Highlight.BorderSizePixel = 0
		Highlight.BackgroundColor3 = Color3.fromRGB(155, 173, 227)
		Highlight.Size = UDim2.new(1, 0, 0, 2)
		Highlight.Visible = false

		local BottomCover = Instance.new("Frame", TabButton)
		BottomCover.BorderSizePixel = 0
		BottomCover.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
		BottomCover.Size = UDim2.new(1, 0, 0, 1)
		BottomCover.Position = UDim2.new(0, 0, 1, 0)
		BottomCover.Visible = false

		-- Tab Page View
		local Page = Instance.new("Frame", TabContainer)
		Page.Name = "page_" .. tabName
		Page.BorderSizePixel = 0
		Page.BackgroundTransparency = 1
		Page.Size = UDim2.new(1, 0, 1, 0)
		Page.Visible = false

		local PagePadding = Instance.new("UIPadding", Page)
		PagePadding.PaddingTop = UDim.new(0, 12)
		PagePadding.PaddingRight = UDim.new(0, 11)
		PagePadding.PaddingLeft = UDim.new(0, 11)

		local PageLayout = Instance.new("UIListLayout", Page)
		PageLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
		PageLayout.Padding = UDim.new(0, 12)
		PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
		PageLayout.FillDirection = Enum.FillDirection.Horizontal

		local function Select()
			for _, tab in pairs(windowData.Tabs) do
				tab.Page.Visible = false
				tab.Button.TextColor3 = Color3.fromRGB(121, 121, 120)
				tab.Highlight.Visible = false
				tab.BottomCover.Visible = false
			end
			Page.Visible = true
			TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
			Highlight.Visible = true
			BottomCover.Visible = true
			windowData.CurrentTab = tabData
		end

		TabButton.MouseButton1Click:Connect(Select)

		tabData.Button = TabButton
		tabData.Highlight = Highlight
		tabData.BottomCover = BottomCover
		tabData.Page = Page
		table.insert(windowData.Tabs, tabData)

		if #windowData.Tabs == 1 then
			Select()
		end

		-- Section Builder
		function tabData:CreateSection()
			local sectionData = {}

			local Section = Instance.new("Frame", Page)
			Section.Name = "section"
			Section.BorderSizePixel = 0
			Section.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
			Section.AutomaticSize = Enum.AutomaticSize.Y
			Section.Size = UDim2.new(0, 223, 0, 0)

			local SecStroke1 = Instance.new("UIStroke", Section)
			SecStroke1.BorderOffset = UDim.new(0, 1)
			SecStroke1.LineJoinMode = Enum.LineJoinMode.Miter

			local SecStroke2 = Instance.new("UIStroke", Section)
			SecStroke2.Color = Color3.fromRGB(71, 71, 71)
			SecStroke2.LineJoinMode = Enum.LineJoinMode.Miter

			local SecLayout = Instance.new("UIListLayout", Section)
			SecLayout.Padding = UDim.new(0, 12)
			SecLayout.SortOrder = Enum.SortOrder.LayoutOrder

			local SecPadding = Instance.new("UIPadding", Section)
			SecPadding.PaddingTop = UDim.new(0, 10)
			SecPadding.PaddingLeft = UDim.new(0.0225, 0)
			SecPadding.PaddingBottom = UDim.new(0, 10)

			-- Toggle Element
			function sectionData:AddToggle(text, default, callback)
				local state = default or false
				callback = callback or function() end

				local ToggleFrame = Instance.new("Frame", Section)
				ToggleFrame.Name = "Toggle"
				ToggleFrame.BorderSizePixel = 0
				ToggleFrame.BackgroundTransparency = 1
				ToggleFrame.Size = UDim2.new(0, 0, 0, 16)

				local ToggleLayout = Instance.new("UIListLayout", ToggleFrame)
				ToggleLayout.Padding = UDim.new(0, 7)
				ToggleLayout.VerticalAlignment = Enum.VerticalAlignment.Center
				ToggleLayout.SortOrder = Enum.SortOrder.LayoutOrder
				ToggleLayout.FillDirection = Enum.FillDirection.Horizontal

				local ToggleButton = Instance.new("TextButton", ToggleFrame)
				ToggleButton.Name = "togglebutton"
				ToggleButton.BorderSizePixel = 0
				ToggleButton.Text = ""
				ToggleButton.Size = UDim2.new(0, 10, 0, 10)
				ToggleButton.BackgroundColor3 = state and Color3.fromRGB(174, 189, 245) or Color3.fromRGB(24, 24, 24)

				local TStroke1 = Instance.new("UIStroke", ToggleButton)
				TStroke1.Color = Color3.fromRGB(71, 71, 71)
				TStroke1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

				local TStroke2 = Instance.new("UIStroke", ToggleButton)
				TStroke2.BorderOffset = UDim.new(0, 1)
				TStroke2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

				local Text = Instance.new("TextLabel", ToggleFrame)
				Text.BorderSizePixel = 0
				Text.TextSize = 14
				Text.TextXAlignment = Enum.TextXAlignment.Left
				Text.TextYAlignment = Enum.TextYAlignment.Top
				Text.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
				Text.TextColor3 = Color3.fromRGB(255, 255, 255)
				Text.BackgroundTransparency = 1
				Text.Size = UDim2.new(1, 0, 1, 0)
				Text.Text = text

				local function UpdateToggle()
					state = not state
					ToggleButton.BackgroundColor3 = state and Color3.fromRGB(174, 189, 245) or Color3.fromRGB(24, 24, 24)
					pcall(callback, state)
				end

				ToggleButton.MouseButton1Click:Connect(UpdateToggle)
			end

			-- Slider Element
			function sectionData:AddSlider(text, min, max, default, callback)
				min = min or 0
				max = max or 100
				default = math.clamp(default or min, min, max)
				callback = callback or function() end

				local SliderFrame = Instance.new("Frame", Section)
				SliderFrame.Name = "slider"
				SliderFrame.BorderSizePixel = 0
				SliderFrame.BackgroundTransparency = 1
				SliderFrame.Size = UDim2.new(0, 205, 0, 30)

				local SliderPadding = Instance.new("UIPadding", SliderFrame)
				SliderPadding.PaddingBottom = UDim.new(0, 4)

				local Title = Instance.new("TextLabel", SliderFrame)
				Title.Name = "Title"
				Title.BorderSizePixel = 0
				Title.TextSize = 14
				Title.TextXAlignment = Enum.TextXAlignment.Left
				Title.TextYAlignment = Enum.TextYAlignment.Top
				Title.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
				Title.TextColor3 = Color3.fromRGB(255, 255, 255)
				Title.BackgroundTransparency = 1
				Title.Size = UDim2.new(0, 205, 0, 15)
				Title.Text = text

				local SliderBase = Instance.new("Frame", SliderFrame)
				SliderBase.Name = "silder base"
				SliderBase.BorderSizePixel = 0
				SliderBase.BackgroundTransparency = 1
				SliderBase.Size = UDim2.new(0, 205, 0, 15)
				SliderBase.Position = UDim2.new(0, 0, 0.59524, 0)

				local BaseStroke = Instance.new("UIStroke", SliderBase)
				BaseStroke.Color = Color3.fromRGB(66, 66, 66)

				local ValueLabel = Instance.new("TextLabel", SliderBase)
				ValueLabel.ZIndex = 2
				ValueLabel.BorderSizePixel = 0
				ValueLabel.TextSize = 14
				ValueLabel.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
				ValueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				ValueLabel.BackgroundTransparency = 1
				ValueLabel.Size = UDim2.new(0, 205, 0, 15)
				ValueLabel.Text = tostring(default)

				local Fill = Instance.new("Frame", SliderBase)
				Fill.Name = "slider fill"
				Fill.BorderSizePixel = 0
				Fill.BackgroundColor3 = Color3.fromRGB(173, 188, 244)
				Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)

				local dragging = false
				local function UpdateSlider(input)
					local pos = math.clamp((input.Position.X - SliderBase.AbsolutePosition.X) / SliderBase.AbsoluteSize.X, 0, 1)
					local val = math.floor(min + ((max - min) * pos))
					Fill.Size = UDim2.new(pos, 0, 1, 0)
					ValueLabel.Text = tostring(val)
					pcall(callback, val)
				end

				SliderBase.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						UpdateSlider(input)
					end
				end)

				game:GetService("UserInputService").InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				game:GetService("UserInputService").InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						UpdateSlider(input)
					end
				end)
			end

			-- Keybind Element
			function sectionData:AddKeybind(text, defaultKey, callback)
				local currentKey = defaultKey or Enum.KeyCode.E
				callback = callback or function() end
				local listening = false

				local KeybindFrame = Instance.new("Frame", Section)
				KeybindFrame.Name = "keybind"
				KeybindFrame.BorderSizePixel = 0
				KeybindFrame.BackgroundTransparency = 1
				KeybindFrame.Size = UDim2.new(0, 205, 0, 16)

				local Layout = Instance.new("UIListLayout", KeybindFrame)
				Layout.Padding = UDim.new(0, 7)
				Layout.VerticalAlignment = Enum.VerticalAlignment.Center
				Layout.FillDirection = Enum.FillDirection.Horizontal

				local Label = Instance.new("TextLabel", KeybindFrame)
				Label.BorderSizePixel = 0
				Label.TextSize = 14
				Label.TextXAlignment = Enum.TextXAlignment.Left
				Label.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
				Label.TextColor3 = Color3.fromRGB(255, 255, 255)
				Label.BackgroundTransparency = 1
				Label.Size = UDim2.new(0.6, 0, 1, 0)
				Label.Text = text

				local KeyLabel = Instance.new("TextLabel", KeybindFrame)
				KeyLabel.BorderSizePixel = 0
				KeyLabel.TextSize = 12
				KeyLabel.TextXAlignment = Enum.TextXAlignment.Right
				KeyLabel.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
				KeyLabel.TextColor3 = Color3.fromRGB(91, 91, 91)
				KeyLabel.BackgroundTransparency = 1
				KeyLabel.Size = UDim2.new(0.35, 0, 1, 0)
				KeyLabel.Text = "[" .. currentKey.Name .. "]"

				KeybindFrame.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						listening = true
						KeyLabel.Text = "[...]"
					end
				end)

				game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
					if listening and input.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						currentKey = input.KeyCode
						KeyLabel.Text = "[" .. currentKey.Name .. "]"
					elseif not gpe and input.KeyCode == currentKey then
						pcall(callback, currentKey)
					end
				end)
			end

			return sectionData
		end

		return tabData
	end

	return windowData
end

return Library
