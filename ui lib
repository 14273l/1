    return self
end

-- Tab Class
local Tab = {}
Tab.__index = Tab

function Window:AddTab(name)
    local tab = setmetatable({}, Tab)
    tab.Name = name
    tab.Parent = self
    tab.Sections = {}
    tab.Elements = {}
    
    -- Create Tab Button
    local button = Instance.new("TextButton", self.TabContainer)
    button.Name = "unselected_tab"
    button.Text = name
    button.TextColor3 = Config.Colors.TextDim
    button.TextSize = 14
    button.FontFace = createFont(Config.Font, Config.FontRegular)
    button.Size = UDim2.new(1, 0, 1, 0)
    button.BackgroundTransparency = 1
    button.BorderSizePixel = 0
    tab.Button = button
    
    createStroke(button, Config.Colors.Border, nil, Enum.ApplyStrokeMode.Border)
    createStroke(button)
    
    -- Tab Content Container
    tab.Container = Instance.new("Frame", self.Content)
    tab.Container.Name = "tab_content"
    tab.Container.BackgroundTransparency = 1
    tab.Container.Size = UDim2.new(1, 0, 1, 0)
    tab.Container.Visible = false
    
    local sectionLayout = Instance.new("UIListLayout", tab.Container)
    sectionLayout.Padding = UDim.new(0, 12)
    sectionLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sectionLayout.FillDirection = Enum.FillDirection.Horizontal
    sectionLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
    
    tab.SectionLayout = sectionLayout
    self.Tabs[#self.Tabs + 1] = tab
    
    -- Click handler
    button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)
    
    -- Select first tab
    if not self.ActiveTab then
        self:SelectTab(tab)
    end
    
    return tab
end

function Window:SelectTab(tab)
    if self.ActiveTab then
        -- Deselect previous
        self.ActiveTab.Button.Name = "unselected_tab"
        self.ActiveTab.Button.TextColor3 = Config.Colors.TextDim
        self.ActiveTab.Container.Visible = false
        local oldHighlight = self.ActiveTab.Button:FindFirstChild("selected tab higlight ")
        if oldHighlight then oldHighlight:Destroy() end
    end
    
    self.ActiveTab = tab
    tab.Button.Name = "selected_tab"
    tab.Button.TextColor3 = Config.Colors.Text
    
    -- Highlight
    local highlight = Instance.new("Frame", tab.Button)
    highlight.Name = "selected tab higlight "
    highlight.BackgroundColor3 = Config.Colors.PrimaryDark
    highlight.Size = UDim2.new(1, 0, 0, 2)
    highlight.BorderSizePixel = 0
    
    createShadow(highlight, Config.Colors.PrimaryDark, 0.5, 0, 8)
    
    -- Bottom border
    local border = Instance.new("Frame", tab.Button)
    border.BackgroundColor3 = Config.Colors.Background
    border.Size = UDim2.new(1, 0, 0, 1)
    border.Position = UDim2.new(0, 0, 1, 0)
    border.BorderSizePixel = 0
    
    tab.Container.Visible = true
end

