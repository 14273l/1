    labelObj.BorderSizePixel = 0
    
    local keyLabel = Instance.new("TextLabel", frame)
    keyLabel.Text = string.format("[%s]", defaultKey or ".")
    keyLabel.TextColor3 = Config.Colors.TextMuted
    keyLabel.TextSize = 12
    keyLabel.TextXAlignment = Enum.TextXAlignment.Right
    keyLabel.FontFace = createFont(Config.Font, Config.FontBold)
    keyLabel.Size = UDim2.new(0, 185, 0, 15)
    keyLabel.Position = UDim2.new(24, 0, 0.03125, 0)
    keyLabel.BackgroundTransparency = 1
    keyLabel.BorderSizePixel = 0
    
    local currentKey = defaultKey or Enum.KeyCode.Period
    local isListening = false
    
    local function updateKeyDisplay()
        keyLabel.Text = string.format("[%s]", tostring(currentKey):gsub("Enum.KeyCode.", ""))
    end
    
    updateKeyDisplay()
    
    button.MouseButton1Click:Connect(function()
        isListening = not isListening
        keyLabel.Text = "[...]"
        keyLabel.TextColor3 = Config.Colors.Primary
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if isListening and not gameProcessed then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                isListening = false
                keyLabel.TextColor3 = Config.Colors.TextMuted
                updateKeyDisplay()
                if callback then callback(currentKey) end
            end
        end
    end)
    
    return {
        SetKey = function(key)
            currentKey = key
            updateKeyDisplay()
            if callback then callback(currentKey) end
        end,
        GetKey = function() return currentKey end
    }
end

function Section:AddDropdown(label, options, default, callback)
    local frame = Instance.new("Frame", self.Frame)
    frame.Name = "dropdown"
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(0, 205, 0, 15)
    frame.BorderSizePixel = 0
