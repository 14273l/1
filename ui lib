--[[
    Phantom Hook UI Library
    by @7notice on discord

    Usage:
        local Library = require(script.Parent.Library)
        local window = Library:CreateWindow("Phantom Hook", game.Players.LocalPlayer.PlayerGui)
        local tab = window:CreateTab("Aimbot")
        local section = tab:CreateSection("General")
        local toggle = section:CreateToggle("Enabled", false, function(value) print("Toggle:", value) end)
        -- ... etc.
]]

local Library = {}
Library.__index = Library

-- Helper to create instances with properties
local function createInstance(className, parent, properties)
    local inst = Instance.new(className)
    if parent then inst.Parent = parent end
    for prop, val in pairs(properties or {}) do
        inst[prop] = val
    end
    return inst
end

-- Fonts used in the original UI
local FONT_SARPANCH_BOLD = Font.new("rbxasset://fonts/families/Sarpanch.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
local FONT_SARPANCH_REGULAR = Font.new("rbxasset://fonts/families/Sarpanch.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)

-- Colors
local COLORS = {
    WindowBg = Color3.fromRGB(29, 31, 35),
    TopBarBg = Color3.fromRGB(29, 31, 35),
    TitleText = Color3.fromRGB(255, 255, 255),
    TabTextActive = Color3.fromRGB(255, 255, 255),
    TabTextInactive = Color3.fromRGB(126, 125, 138),
    SectionBg = Color3.fromRGB(25, 28, 31),
    SectionStroke = Color3.fromRGB(38, 39, 44),
    ToggleBg = Color3.fromRGB(152, 152, 168),
    SliderBg = Color3.fromRGB(38, 39, 45),
    SliderFill = Color3.fromRGB(152, 152, 168),
    DropdownBg = Color3.fromRGB(38, 39, 45),
    KeybindBg = Color3.fromRGB(38, 39, 45),
    Separator = Color3.fromRGB(57, 58, 66),
}

-- Main Window Class
local Window = {}
Window.__index = Window

function Window:CreateWindow(title, parent, options)
    options = options or {}
    local self = setmetatable({}, Window)
    self.Title = title or "Window"
    self.Parent = parent or game.Players.LocalPlayer:WaitForChild("PlayerGui")
    self.Size = options.Size or UDim2.new(0, 520, 0, 305)
    self.Position = options.Position or UDim2.new(0.29907, 0, 0.31341, 0)
    self.Draggable = options.Draggable ~= false
    self.Tabs = {}
    self.CurrentTab = nil

    -- Create ScreenGui
    self.Gui = createInstance("ScreenGui", self.Parent, {
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })

    -- Main Window Frame
    self.Frame = createInstance("Frame", self.Gui, {
        Name = "window",
        BackgroundColor3 = COLORS.WindowBg,
        BorderSizePixel = 0,
        BorderColor3 = Color3.new(0,0,0),
        Size = self.Size,
        Position = self.Position,
    })

    -- Top Bar
    self.TopBar = createInstance("Frame", self.Frame, {
        Name = "top bar",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 24),
    })

    -- Title
    self.TitleLabel = createInstance("TextLabel", self.TopBar, {
        Name = "Title",
        BackgroundColor3 = COLORS.WindowBg,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0.25, 0, 1, 0),
        Text = title,
        TextColor3 = COLORS.TitleText,
        TextSize = 14,
        FontFace = FONT_SARPANCH_BOLD,
        RichText = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Padding for top bar
    createInstance("UIPadding", self.TopBar, {
        PaddingLeft = UDim.new(0, 9),
        PaddingRight = UDim.new(0, 9),
    })

    -- Container for tab buttons
    self.TabContainer = createInstance("Frame", self.TopBar, {
        Name = "tab buttons",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0.75, 0, 1, 0),
        Position = UDim2.new(0.25, 0, 0, 0),
    })

    -- Layout for tab buttons (horizontal, right-aligned)
    self.TabLayout = createInstance("UIListLayout", self.TabContainer, {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        Padding = UDim.new(0, 25),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Content frame where tab contents will be placed
    self.Content = createInstance("Frame", self.Frame, {
        Name = "tab",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 1, 1, -24),
        Position = UDim2.new(0, 0, 0, 24),
    })

    -- Padding for content
    createInstance("UIPadding", self.Content, {
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    })

    -- Layout for tabs inside content (horizontal, fill)
    self.ContentLayout = createInstance("UIListLayout", self.Content, {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Dragging logic
    if self.Draggable then
        local dragging, dragInput, dragStart, startPos
        self.TopBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                dragStart = input.Position
                startPos = self.Frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        self.TopBar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                dragInput = input
            end
        end)
        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                self.Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    return self
end

function Window:CreateTab(name)
    local tab = {}
    tab.Name = name
    tab.Window = self

    -- Tab button
    tab.Button = createInstance("TextButton", self.TabContainer, {
        Name = "tabbutton",
        Text = name,
        TextSize = 14,
        TextColor3 = COLORS.TabTextInactive,
        FontFace = FONT_SARPANCH_BOLD,
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 50),
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    -- Tab content frame (will be placed in Content)
    tab.Content = createInstance("Frame", self.Content, {
        Name = "tabcontent_" .. name,
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0), -- Will be sized by layout
        Visible = false,
    })

    -- Layout for sections (horizontal)
    createInstance("UIListLayout", tab.Content, {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    createInstance("UIPadding", tab.Content, {
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    })

    tab.Sections = {}
    tab.CurrentSection = nil

    -- Button click to select tab
    tab.Button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    -- Store tab
    table.insert(self.Tabs, tab)
    if not self.CurrentTab then
        self:SelectTab(tab)
    end

    return tab
end

function Window:SelectTab(tab)
    if self.CurrentTab == tab then return end
    -- Deselect previous
    if self.CurrentTab then
        self.CurrentTab.Button.TextColor3 = COLORS.TabTextInactive
        self.CurrentTab.Content.Visible = false
    end
    -- Select new
    self.CurrentTab = tab
    tab.Button.TextColor3 = COLORS.TabTextActive
    tab.Content.Visible = true
end

-- Section Class
local Section = {}
Section.__index = Section

function Window:CreateSection(parentTab, name)
    local section = setmetatable({}, Section)
    section.Name = name or "section"
    section.Tab = parentTab
    section.Elements = {}

    -- ScrollingFrame as section container
    section.Frame = createInstance("ScrollingFrame", parentTab.Content, {
        Name = "section",
        BackgroundColor3 = COLORS.SectionBg,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 100),
        ScrollBarThickness = 0,
        Active = true,
        AutomaticSize = Enum.AutomaticSize.None,
        CanvasSize = UDim2.new(0, 0, 0, 0), -- will be adjusted
        ScrollBarImageColor3 = Color3.new(0,0,0),
    })

    -- UIStroke border
    createInstance("UIStroke", section.Frame, {
        Color = COLORS.SectionStroke,
        LineJoinMode = Enum.LineJoinMode.Miter,
    })

    -- Padding inside section
    createInstance("UIPadding", section.Frame, {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })

    -- Layout for elements (vertical)
    local layout = createInstance("UIListLayout", section.Frame, {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 12),
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
    })

    -- Update CanvasSize when layout changes
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        section.Frame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    table.insert(parentTab.Sections, section)
    return section
end

-- Helper to create a toggle
function Section:CreateToggle(label, default, callback)
    local toggle = {}
    toggle.Label = label
    toggle.Value = default or false
    toggle.Callback = callback or function() end

    -- Container frame
    local container = createInstance("Frame", self.Frame, {
        Name = "Toggle",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 0, 16),
    })

    -- Horizontal layout
    createInstance("UIListLayout", container, {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Toggle button (small square)
    local button = createInstance("TextButton", container, {
        Name = "togglebutton",
        Text = "",
        TextSize = 14,
        BackgroundColor3 = COLORS.ToggleBg,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, 0, 0.5, 0),
        AutoButtonColor = false,
    })

    -- Label
    local textLabel = createInstance("TextLabel", container, {
        Name = "TextLabel",
        Text = label,
        TextSize = 14,
        TextColor3 = Color3.fromRGB(255,255,255),
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        FontFace = FONT_SARPANCH_REGULAR,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Update appearance
    local function updateToggle()
        if toggle.Value then
            button.BackgroundColor3 = Color3.fromRGB(100, 200, 100) -- Green when on
        else
            button.BackgroundColor3 = COLORS.ToggleBg
        end
    end
    updateToggle()

    button.MouseButton1Click:Connect(function()
        toggle.Value = not toggle.Value
        updateToggle()
        toggle.Callback(toggle.Value)
    end)

    toggle.Container = container
    toggle.Button = button
    toggle.LabelObject = textLabel
    table.insert(self.Elements, toggle)
    return toggle
end

-- Helper to create a slider
function Section:CreateSlider(label, min, max, default, callback)
    local slider = {}
    slider.Label = label
    slider.Min = min or 0
    slider.Max = max or 100
    slider.Value = default or slider.Min
    slider.Callback = callback or function() end

    -- Container
    local container = createInstance("Frame", self.Frame, {
        Name = "slider",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 32),
    })

    createInstance("UIListLayout", container, {
        FillDirection = Enum.FillDirection.Vertical,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Label and value display
    local labelFrame = createInstance("Frame", container, {
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 14),
    })
    local labelText = createInstance("TextLabel", labelFrame, {
        Text = label .. " 0",
        TextSize = 14,
        TextColor3 = Color3.fromRGB(255,255,255),
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        FontFace = FONT_SARPANCH_BOLD,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Slider background
    local bg = createInstance("Frame", container, {
        Name = "slider bg",
        BackgroundColor3 = COLORS.SliderBg,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 9),
    })

    -- Fill (the draggable part)
    local fill = createInstance("Frame", bg, {
        BackgroundColor3 = COLORS.SliderFill,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
    })

    -- Drag handle (a small button at the end of fill)
    local handle = createInstance("TextButton", bg, {
        Text = "",
        BackgroundColor3 = COLORS.SliderFill,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 10, 0, 12),
        Position = UDim2.new(0, 0, 0.5, 0),
        AutoButtonColor = false,
    })

    -- Update slider value and visuals
    local function updateSlider(value)
        local clamped = math.clamp(value, slider.Min, slider.Max)
        slider.Value = clamped
        local percent = (clamped - slider.Min) / (slider.Max - slider.Min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        handle.Position = UDim2.new(percent, -5, 0.5, 0) -- offset to center handle
        labelText.Text = label .. " " .. math.floor(clamped)
        slider.Callback(clamped)
    end

    updateSlider(default or slider.Min)

    -- Drag logic on handle and bg
    local dragging = false
    local function startDrag(input)
        dragging = true
    end
    local function moveDrag(input)
        if not dragging then return end
        local relativeX = input.Position.X - bg.AbsolutePosition.X
        local width = bg.AbsoluteSize.X
        local percent = math.clamp(relativeX / width, 0, 1)
        local value = slider.Min + (slider.Max - slider.Min) * percent
        updateSlider(value)
    end
    local function endDrag()
        dragging = false
    end

    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            startDrag(input)
            moveDrag(input) -- immediately update to click position
        end
    end)
    bg.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            endDrag()
        end
    end)
    bg.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            moveDrag(input)
        end
    end)

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            startDrag(input)
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            endDrag()
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            moveDrag(input)
        end
    end)

    slider.Container = container
    slider.Fill = fill
    slider.Handle = handle
    slider.LabelObject = labelText
    slider.Update = updateSlider
    table.insert(self.Elements, slider)
    return slider
end

-- Helper to create a dropdown
function Section:CreateDropdown(label, options, default, callback)
    local dropdown = {}
    dropdown.Label = label
    dropdown.Options = options or {}
    dropdown.Selected = default or (options and options[1]) or ""
    dropdown.Callback = callback or function() end
    dropdown.Expanded = false

    -- Container
    local container = createInstance("Frame", self.Frame, {
        Name = "dropdown",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 16),
    })

    createInstance("UIListLayout", container, {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Main dropdown frame
    local main = createInstance("Frame", container, {
        BackgroundColor3 = COLORS.DropdownBg,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 16),
    })

    -- The button that shows selected value
    local selectButton = createInstance("TextButton", main, {
        Text = dropdown.Selected,
        TextSize = 14,
        TextColor3 = Color3.fromRGB(255,255,255),
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 84, 1, 0),
        FontFace = FONT_SARPANCH_BOLD,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Arrow image
    local arrow = createInstance("ImageButton", main, {
        Image = "rbxassetid://17253632400",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 84, 0, 0),
    })

    -- Dropdown list (initially hidden)
    local list = createInstance("ScrollingFrame", container, {
        BackgroundColor3 = COLORS.DropdownBg,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 0),
        Visible = false,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })
    createInstance("UIListLayout", list, {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    })

    -- Populate options
    local buttons = {}
    for _, opt in ipairs(options) do
        local btn = createInstance("TextButton", list, {
            Text = opt,
            TextSize = 14,
            TextColor3 = Color3.fromRGB(255,255,255),
            BackgroundColor3 = Color3.new(1,1,1),
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 16),
            FontFace = FONT_SARPANCH_REGULAR,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        btn.MouseButton1Click:Connect(function()
            dropdown.Selected = opt
            selectButton.Text = opt
            dropdown.Callback(opt)
            dropdown.Expanded = false
            list.Visible = false
        end)
        table.insert(buttons, btn)
    end

    -- Toggle list on button click
    selectButton.MouseButton1Click:Connect(function()
        dropdown.Expanded = not dropdown.Expanded
        list.Visible = dropdown.Expanded
        if dropdown.Expanded then
            list.Size = UDim2.new(0, 100, 0, math.min(#options * 18 + 10, 100))
        else
            list.Size = UDim2.new(0, 100, 0, 0)
        end
    end)

    arrow.MouseButton1Click:Connect(function()
        selectButton.MouseButton1Click:Fire()
    end)

    dropdown.Container = container
    dropdown.SelectButton = selectButton
    dropdown.List = list
    dropdown.Buttons = buttons
    table.insert(self.Elements, dropdown)
    return dropdown
end

-- Helper to create a keybind
function Section:CreateKeybind(label, default, callback)
    local keybind = {}
    keybind.Label = label
    keybind.Key = default or Enum.KeyCode.None
    keybind.Callback = callback or function() end
    keybind.Listening = false

    -- Container
    local container = createInstance("Frame", self.Frame, {
        Name = "keybind",
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 16),
    })

    createInstance("UIListLayout", container, {
        FillDirection = Enum.FillDirection.Horizontal,
        VerticalFlex = Enum.UIFlexAlignment.Fill,
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    -- Label
    local labelText = createInstance("TextLabel", container, {
        Text = label,
        TextSize = 14,
        TextColor3 = Color3.fromRGB(255,255,255),
        BackgroundColor3 = Color3.new(1,1,1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -100, 1, 0),
        FontFace = FONT_SARPANCH_REGULAR,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    -- Key button
    local keyButton = createInstance("TextButton", container, {
        Text = tostring(keybind.Key),
        TextSize = 14,
        TextColor3 = Color3.fromRGB(255,255,255),
        BackgroundColor3 = COLORS.KeybindBg,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 1, 0),
        FontFace = FONT_SARPANCH_BOLD,
    })

    -- Listen for keypress when clicked
    keyButton.MouseButton1Click:Connect(function()
        if keybind.Listening then
            keybind.Listening = false
            keyButton.Text = tostring(keybind.Key)
            return
        end
        keybind.Listening = true
        keyButton.Text = "..."
    end)

    -- Input service connection
    local inputService = game:GetService("UserInputService")
    local connection
    connection = inputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not keybind.Listening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            keybind.Key = input.KeyCode
            keybind.Listening = false
            keyButton.Text = tostring(keybind.Key)
            keybind.Callback(keybind.Key)
            connection:Disconnect()
        end
    end)

    keybind.Container = container
    keybind.KeyButton = keyButton
    table.insert(self.Elements, keybind)
    return keybind
end

-- Helper to create a separator (line)
function Section:CreateSeparator()
    local sep = createInstance("Frame", self.Frame, {
        Name = "seperator",
        BackgroundColor3 = COLORS.Separator,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 100, 0, 1),
    })
    table.insert(self.Elements, sep)
    return sep
end

-- Export Library functions
function Library:CreateWindow(title, parent, options)
    return Window:CreateWindow(title, parent, options)
end

-- (Optional) allow overriding theme colors
function Library:SetTheme(theme)
    for k, v in pairs(theme) do
        COLORS[k] = v
    end
end

return Library
