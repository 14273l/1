-- Utility Functions
local function createFont(family, weight, style)
    return Font.new(family, weight or Enum.FontWeight.Regular, style or Enum.FontStyle.Normal)
end

local function createShadow(parent, color, transparency, blur, size)
    local shadow = Instance.new("UIShadow", parent)
    if color then shadow.Color = color end
    if transparency then shadow.Transparency = transparency end
    if blur then shadow.Blur = blur end
    if size then shadow.Size = size end
    return shadow
end

local function createStroke(parent, color, thickness, applyMode, joinMode)
    local stroke = Instance.new("UIStroke", parent)
    if color then stroke.Color = color end
    if thickness then stroke.Thickness = thickness end
    if applyMode then stroke.ApplyStrokeMode = applyMode end
    stroke.LineJoinMode = joinMode or Enum.LineJoinMode.Miter
    return stroke
end

local function createPadding(parent, left, right, top, bottom)
    local padding = Instance.new("UIPadding", parent)
    if left then padding.PaddingLeft = UDim.new(0, left) end
    if right then padding.PaddingRight = UDim.new(0, right) end
    if top then padding.PaddingTop = UDim.new(0, top) end
    if bottom then padding.PaddingBottom = UDim.new(0, bottom) end
    return padding
end

local function createListLayout(parent, padding, direction, sortOrder, verticalAlignment, horizontalFlex)
    local layout = Instance.new("UIListLayout", parent)
    if padding then layout.Padding = UDim.new(0, padding) end
    if direction then layout.FillDirection = direction end
    if sortOrder then layout.SortOrder = sortOrder end
    if verticalAlignment then layout.VerticalAlignment = verticalAlignment end
    if horizontalFlex then layout.HorizontalFlex = horizontalFlex end
    return layout
end

