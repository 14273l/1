-- Element Creation Methods
function Section:AddToggle(label, default, callback)
    local frame = Instance.new("Frame", self.Frame)
    frame.Name = "Toggle"
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(0, 0, 0, 16)
    frame.BorderSizePixel = 0
    frame.AutomaticSize = Enum.AutomaticSize.Y
    
    local layout = Instance.new("UIListLayout", frame)
    layout.Padding = UDim.new(0, 7)
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.FillDirection = Enum.FillDirection.Horizontal
    
    local button = Instance.new("TextButton", frame)
    button.Name = "togglebutton"
    button.Text = ""
    button.TextSize = 100
    button.Size = UDim2.new(0, 10, 0, 10)
    button.Position = UDim2.new(0, 0, 0.5, 0)
    button.BorderSizePixel = 0
    
    local state = default or false
    
    local function updateToggle()
        if state then
            button.BackgroundColor3 = Config.Colors.Primary
            button.BorderColor3 = Config.Colors.BorderLight
        else
            button.BackgroundColor3 = Config.Colors.Background
            button.BorderColor3 = Config.Colors.BorderDim
        end
    end
    
    createStroke(button, Config.Colors.BorderLight, nil, Enum.ApplyStrokeMode.Border)
    createStroke(button, nil, nil, Enum.ApplyStrokeMode.Border)
    if state then
        createShadow(button, Config.Colors.Primary, 0.5, 0, 8)
    end
    
    local labelObj = Instance.new("TextLabel", frame)
    labelObj.Text = label
    labelObj.TextColor3 = Config.Colors.Text
    labelObj.TextSize = 14
    labelObj.TextXAlignment = Enum.TextXAlignment.Left
    labelObj.TextYAlignment = Enum.TextYAlignment.Top
    labelObj.FontFace = createFont(Config.Font, Config.FontRegular)
    labelObj.Size = UDim2.new(1, 0, 1, 0)
    labelObj.BackgroundTransparency = 1
    labelObj.BorderSizePixel = 0
    
    updateToggle()
    
    button.MouseButton1Click:Connect(function()
        state = not state
        updateToggle()
        if callback then callback(state) end
    end)
    
    return {
        Set = function(value)
            state = value
            updateToggle()
            if callback then callback(state) end
        end,
        Get = function() return state end,
        Toggle = function()
            state = not state
            updateToggle()
            if callback then callback(state) end
        end
    }
end

