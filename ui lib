-- Arch.nem UI Library
-- A dark-themed UI library for Roblox with a modern aesthetic
-- Original design from converted GUI, refactored into a reusable library

local UILibrary = {}
UILibrary.__index = UILibrary

-- Theme colors
local Theme = {
    Background = Color3.fromRGB(25, 26, 26),
    BackgroundSecondary = Color3.fromRGB(27, 28, 28),
    BackgroundElement = Color3.fromRGB(30, 30, 30),
    Accent = Color3.fromRGB(29, 48, 52),
    AccentLight = Color3.fromRGB(33, 48, 51),
    Border = Color3.fromRGB(52, 52, 51),
    BorderAccent = Color3.fromRGB(23, 49, 53),
    TextPrimary = Color3.fromRGB(255, 255, 255),
    TextSecondary = Color3.fromRGB(48, 50, 51),
    TextAccent = Color3.fromRGB(29, 48, 52),
    TextMuted = Color3.fromRGB(113, 114, 115),
    Shadow = Color3.fromRGB(0, 0, 0),
}

-- Fonts
local function getFont(family, weight, style)
    return Font.new(string.format("rbxasset://fonts/families/%s.json", family), weight or Enum.FontWeight.Bold, style or Enum.FontStyle.Normal)
end

local Fonts = {
    Jura = getFont("Jura", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
    JuraRegular = getFont("Jura", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
    SourceSans = getFont("SourceSansPro", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
}

-- Utility functions
local function createStroke(parent, color, borderOffset)
    local stroke = Instance.new("UIStroke", parent)
    stroke.Color = color or Theme.Border
    stroke.LineJoinMode = Enum.LineJoinMode.Miter
    if borderOffset then
        stroke.BorderOffset = UDim.new(0, 1)
    end
    return stroke
end

local function createShadow(parent)
    return Instance.new("UIShadow", parent)
end

local function createUIPadding(parent, padding)
    local uiPadding = Instance.new("UIPadding", parent)
    uiPadding.PaddingTop = padding and padding.Top or UDim.new(0, 0)
    uiPadding.PaddingBottom = padding and padding.Bottom or UDim.new(0, 0)
    uiPadding.PaddingLeft = padding and padding.Left or UDim.new(0, 0)
    uiPadding.PaddingRight = padding and padding.Right or UDim.new(0, 0)
    return uiPadding
end

local function createUIListLayout(parent, direction, padding, sortOrder)
    local layout = Instance.new("UIListLayout", parent)
    layout.FillDirection = direction or Enum.FillDirection.Vertical
    layout.Padding = UDim.new(0, padding or 5)
    layout.SortOrder = sortOrder or Enum.SortOrder.LayoutOrder
    return layout
end

-- Main Window Class
function UILibrary.new(title, size, position)
    local self = setmetatable({}, UILibrary)
    
    self.PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    self.Window = Instance.new("ScreenGui", self.PlayerGui)
    self.Window.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    self.Window.Name = "ArchNemUI"
    
    -- Main Frame
    self.MainFrame = Instance.new("Frame", self.Window)
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.BackgroundColor3 = Theme.Background
    self.MainFrame.Size = size or UDim2.new(0, 548, 0, 398)
    self.MainFrame.Position = position or UDim2.new(0.28793, 0, 0.25732, 0)
    self.MainFrame.BorderColor3 = Color3.fromRGB(0, 0, 0)
    self.MainFrame.Name = "Window"
    
    -- Window border
    createStroke(self.MainFrame, Theme.Border)
    local stroke2 = createStroke(self.MainFrame, Theme.Border, true)
    stroke2.BorderOffset = UDim.new(0, 1)
    
    -- Title bar
    self.TitleBar = Instance.new("Frame", self.MainFrame)
    self.TitleBar.BorderSizePixel = 0
    self.TitleBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    self.TitleBar.Size = UDim2.new(0, self.MainFrame.Size.X.Offset, 0, 25)
    self.TitleBar.BorderColor3 = Color3.fromRGB(0, 0, 0)
    self.TitleBar.Name = "Top bar"
    self.TitleBar.BackgroundTransparency = 1
    
    createUIPadding(self.TitleBar, {Left = UDim.new(0, 9), Right = UDim.new(0, 9)})
    
    -- Title text
    local titleLabel = Instance.new("TextLabel", self.TitleBar)
    titleLabel.TextStrokeTransparency = 0
    titleLabel.BorderSizePixel = 0
    titleLabel.TextSize = 14
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.FontFace = Fonts.Jura
    titleLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.RichText = true
    titleLabel.Size = UDim2.new(0, 200, 0, 26)
    titleLabel.BorderColor3 = Color3.fromRGB(0, 0, 0)
    titleLabel.Text = string.format('<font color="rgb(24, 43, 55)">Arch</font><font color="rgb(255,255,255)">.nem</font>')
    
    -- Tabs container
    self.TabsContainer = Instance.new("Frame", self.TitleBar)
    self.TabsContainer.BorderSizePixel = 0
    self.TabsContainer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    self.TabsContainer.Size = UDim2.new(0, 380, 0, 26)
    self.TabsContainer.Position = UDim2.new(0.28113, 0, 0, 0)
    self.TabsContainer.BorderColor3 = Color3.fromRGB(0, 0, 0)
    self.TabsContainer.BackgroundTransparency = 1
    
    local tabsLayout = createUIListLayout(self.TabsContainer, Enum.FillDirection.Horizontal, 5)
    tabsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    tabsLayout.HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween
    tabsLayout.VerticalFlex = Enum.UIFlexAlignment.Fill
    
    -- Section frame
    self.Section = Instance.new("Frame", self.MainFrame)
    self.Section.BorderSizePixel = 0
    self.Section.BackgroundColor3 = Theme.BackgroundSecondary
    self.Section.Size = UDim2.new(0, self.MainFrame.Size.X.Offset - 20, 0, self.MainFrame.Size.Y.Offset - 34)
    self.Section.Position = UDim2.new(0.01825, 0, 0.06533, 0)
    self.Section.BorderColor3 = Color3.fromRGB(0, 0, 0)
    self.Section.Name = "Section"
    
    createStroke(self.Section, Theme.BorderAccent)
    local sectionStroke2 = createStroke(self.Section, Theme.Border, true)
    sectionStroke2.BorderOffset = UDim.new(0, 1)
    
    createUIPadding(self.Section, {
        Top = UDim.new(0, 10),
        Bottom = UDim.new(0, 10),
        Left = UDim.new(0, 10),
        Right = UDim.new(0, 10)
    })
    
    createShadow(self.Section)
    
    -- Scrolling frame
    self.ScrollingFrame = Instance.new("ScrollingFrame", self.Section)
    self.ScrollingFrame.Active = true
    self.ScrollingFrame.BorderSizePixel = 0
    self.ScrollingFrame.BackgroundColor3 = Theme.Background
    self.ScrollingFrame.Size = UDim2.new(1, 0, 1, 0)
    self.ScrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(0, 0, 0)
    self.ScrollingFrame.BorderColor3 = Color3.fromRGB(0, 0, 0)
    self.ScrollingFrame.ScrollBarThickness = 0
    
    createUIPadding(self.ScrollingFrame, {
        Top = UDim.new(0, 9),
        Bottom = UDim.new(0, 9),
        Left = UDim.new(0, 9),
        Right = UDim.new(0, 9)
    })
    
    local scrollLayout = createUIListLayout(self.ScrollingFrame, Enum.FillDirection.Vertical, 12)
    scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
    
    self.Tabs = {}
    self.CurrentTab = nil
    self.Elements = {}
    self.Dropdowns = {}
    
    return self
end

-- Add a tab to the window
function UILibrary:AddTab(name)
    local tabButton = Instance.new("TextButton", self.TabsContainer)
    tabButton.TextStrokeTransparency = 0
    tabButton.BorderSizePixel = 0
    tabButton.TextSize = 14
    tabButton.TextColor3 = Theme.TextSecondary
    tabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tabButton.FontFace = Fonts.Jura
    tabButton.BackgroundTransparency = 1
    tabButton.Size = UDim2.new(0, 70, 0, 26)
    tabButton.BorderColor3 = Color3.fromRGB(0, 0, 0)
    tabButton.Text = name
    tabButton.Name = "Tab"
    tabButton.Position = UDim2.new(0.99737, 0, 0, 0)
    
    -- Create tab content container (hidden by default)
    local tabContent = Instance.new("Frame", self.ScrollingFrame)
    tabContent.BorderSizePixel = 0
    tabContent.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tabContent.Size = UDim2.new(1, 0, 0, 0)
    tabContent.BorderColor3 = Color3.fromRGB(0, 0, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.Name = name .. "Content"
    tabContent.Visible = false
    tabContent.AutomaticSize = Enum.AutomaticSize.Y
    
    local tabLayout = createUIListLayout(tabContent, Enum.FillDirection.Vertical, 12)
    tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
    
    self.Tabs[name] = {
        Button = tabButton,
        Content = tabContent,
        Elements = {}
    }
    
    -- Select first tab by default
    if not self.CurrentTab then
        self:SelectTab(name)
    end
    
    -- Tab click handler
    tabButton.MouseButton1Click:Connect(function()
        self:SelectTab(name)
    end)
    
    return self.Tabs[name]
end

-- Select a tab
function UILibrary:SelectTab(name)
    if self.CurrentTab then
        self.Tabs[self.CurrentTab].Button.TextColor3 = Theme.TextSecondary
        self.Tabs[self.CurrentTab].Content.Visible = false
    end
    
    self.CurrentTab = name
    self.Tabs[name].Button.TextColor3 = Theme.TextAccent
    self.Tabs[name].Content.Visible = true
    
    -- Update scrolling frame size
    self.ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, self.Tabs[name].Content.AbsoluteSize.Y + 20)
end

-- Create a toggle element
function UILibrary:Toggle(parent, label, default, callback)
    local container = Instance.new("Frame", parent)
    container.BorderSizePixel = 0
    container.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    container.Size = UDim2.new(0, 0, 0, 16)
    container.BorderColor3 = Color3.fromRGB(0, 0, 0)
    container.BackgroundTransparency = 1
    container.Name = label .. "Toggle"
    container.AutomaticSize = Enum.AutomaticSize.X
    
    local layout = createUIListLayout(container, Enum.FillDirection.Horizontal, 8)
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    local toggleButton = Instance.new("TextButton", container)
    toggleButton.BorderSizePixel = 0
    toggleButton.TextSize = 100
    toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    toggleButton.BackgroundColor3 = default and Theme.Accent or Theme.BackgroundElement
    toggleButton.FontFace = Fonts.SourceSans
    toggleButton.Size = UDim2.new(0, 12, 0, 12)
    toggleButton.BorderColor3 = Color3.fromRGB(0, 0, 0)
    toggleButton.Text = ""
    toggleButton.Name = "togglebutton"
    toggleButton.Position = UDim2.new(0, 0, 0.5, 0)
    
    createStroke(toggleButton, Theme.Border)
    local stroke2 = createStroke(toggleButton, Theme.Border, true)
    stroke2.BorderOffset = UDim.new(0, 1)
    createShadow(toggleButton)
    
    local labelText = Instance.new("TextLabel", container)
    labelText.TextStrokeTransparency = 0
    labelText.BorderSizePixel = 0
    labelText.TextSize = 14
    labelText.TextXAlignment = Enum.TextXAlignment.Left
    labelText.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    labelText.FontFace = Fonts.Jura
    labelText.TextColor3 = default and Theme.TextPrimary or Theme.TextSecondary
    labelText.BackgroundTransparency = 1
    labelText.Size = UDim2.new(1, 0, 1, 0)
    labelText.BorderColor3 = Color3.fromRGB(0, 0, 0)
    labelText.Text = label
    labelText.Name = "Label"
    
    local state = default or false
    
    toggleButton.MouseButton1Click:Connect(function()
        state = not state
        toggleButton.BackgroundColor3 = state and Theme.Accent or Theme.BackgroundElement
        labelText.TextColor3 = state and Theme.TextPrimary or Theme.TextSecondary
        if callback then callback(state) end
    end)
    
    return {
        SetState = function(newState)
            state = newState
            toggleButton.BackgroundColor3 = state and Theme.Accent or Theme.BackgroundElement
            labelText.TextColor3 = state and Theme.TextPrimary or Theme.TextSecondary
        end,
        GetState = function() return state end,
        Button = toggleButton,
    }
end

-- Create a keybind element
function UILibrary:Keybind(parent, label, defaultKey, callback)
    local container = Instance.new("Frame", parent)
    container.BorderSizePixel = 0
    container.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    container.Size = UDim2.new(0, 100, 0, 16)
    container.BorderColor3 = Color3.fromRGB(0, 0, 0)
    container.BackgroundTransparency = 1
    container.Name = label .. "Keybind"
    
    local keyButton = Instance.new("TextButton", container)
    keyButton.BorderSizePixel = 0
    keyButton.TextSize = 14
    keyButton.TextColor3 = Theme.TextPrimary
    keyButton.BackgroundColor3 = Theme.Background
    keyButton.FontFace = Fonts.Jura
    keyButton.Size = UDim2.new(0, 100, 1, 0)
    keyButton.BorderColor3 = Color3.fromRGB(0, 0, 0)
    keyButton.Text = defaultKey or "None"
    keyButton.Name = "button"
    
    createStroke(keyButton, Theme.Border, true)
    local stroke2 = createStroke(keyButton, Theme.BorderAccent)
    stroke2.BorderOffset = UDim.new(0, 1)
    
    local key = defaultKey or "None"
    local listening = false
    
    keyButton.MouseButton1Click:Connect(function()
        listening = true
        keyButton.Text = "..."
    end)
    
    -- Input handling
    local userInputService = game:GetService("UserInputService")
    local connection
    
    connection = userInputService.InputBegan:Connect(function(input, gameProcessed)
        if listening and not gameProcessed then
            listening = false
            if connection then connection:Disconnect() end
            
            local keyName = input.KeyCode.Name
            if input.KeyCode == Enum.KeyCode.Unknown then
                keyName = input.UserInputType.Name
            end
            
            key = keyName
            keyButton.Text = keyName
            if callback then callback(key) end
        end
    end)
    
    return {
        SetKey = function(newKey)
            key = newKey
            keyButton.Text = newKey
        end,
        GetKey = function() return key end,
    }
end

-- Create a slider element
function UILibrary:Slider(parent, label, min, max, default, callback)
    local container = Instance.new("Frame", parent)
    container.BorderSizePixel = 0
    container.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    container.Size = UDim2.new(0, 205, 0, 30)
    container.Position = UDim2.new(0, 0, 0.78169, 0)
    container.BorderColor3 = Color3.fromRGB(0, 0, 0)
    container.Name = label .. "Slider"
    container.BackgroundTransparency = 1
    
    createUIPadding(container, {Bottom = UDim.new(0, 4)})
    
    local title = Instance.new("TextLabel", container)
    title.TextStrokeTransparency = 0
    title.BorderSizePixel = 0
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextYAlignment = Enum.TextYAlignment.Top
    title.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    title.FontFace = Fonts.Jura
    title.TextColor3 = Theme.TextPrimary
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(0, 205, 0, 15)
    title.BorderColor3 = Color3.fromRGB(0, 0, 0)
    title.Text = label
    title.Name = "Title"
    
    local sliderBase = Instance.new("Frame", container)
    sliderBase.BorderSizePixel = 0
    sliderBase.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderBase.Size = UDim2.new(0, 205, 0, 15)
    sliderBase.Position = UDim2.new(0, 0, 0.59524, 0)
    sliderBase.BorderColor3 = Color3.fromRGB(0, 0, 0)
    sliderBase.Name = "slider base"
    sliderBase.BackgroundTransparency = 1
    
    createStroke(sliderBase, Theme.AccentLight)
    local stroke2 = createStroke(sliderBase, Theme.Border, true)
    stroke2.BorderOffset = UDim.new(0, 1)
    
    local valueLabel = Instance.new("TextLabel", sliderBase)
    valueLabel.TextStrokeTransparency = 0
    valueLabel.ZIndex = 2
    valueLabel.BorderSizePixel = 0
    valueLabel.TextSize = 14
    valueLabel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    valueLabel.FontFace = Fonts.Jura
    valueLabel.TextColor3 = Theme.TextPrimary
    valueLabel.BackgroundTransparency = 1
    valueLabel.Size = UDim2.new(0, 205, 0, 15)
    valueLabel.BorderColor3 = Color3.fromRGB(0, 0, 0)
    valueLabel.Text = tostring(default or 0)
    valueLabel.Name = "ValueLabel"
    
    local fill = Instance.new("Frame", sliderBase)
    fill.SizeConstraint = Enum.SizeConstraint.RelativeXX
    fill.BorderSizePixel = 0
    fill.BackgroundColor3 = Theme.AccentLight
    fill.Size = UDim2.new(0, 0, 0, 15)
    fill.BorderColor3 = Color3.fromRGB(0, 0, 0)
    fill.Name = "slider fill"
    
    createShadow(fill)
    
    local currentValue = default or 0
    local dragging = false
    
    local function updateSlider(value)
        currentValue = math.clamp(value, min, max)
        local percentage = (currentValue - min) / (max - min)
        fill.Size = UDim2.new(percentage, 0, 0, 15)
        valueLabel.Text = tostring(math.floor(currentValue))
        if callback then callback(currentValue) end
    end
    
    updateSlider(currentValue)
    
    local function getMousePosition()
        local mouse = game:GetService("Players").LocalPlayer:GetMouse()
        local relativeX = mouse.X - sliderBase.AbsolutePosition.X
        local percentage = math.clamp(relativeX / sliderBase.AbsoluteSize.X, 0, 1)
        return min + (max - min) * percentage
    end
    
    sliderBase.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(getMousePosition())
        end
    end)
    
    sliderBase.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    sliderBase.MouseMove:Connect(function()
        if dragging then
            updateSlider(getMousePosition())
        end
    end)
    
    return {
        SetValue = function(value)
            updateSlider(value)
        end,
        GetValue = function() return currentValue end,
    }
end

-- Create a dropdown element
function UILibrary:Dropdown(parent, label, options, default, callback)
    local container = Instance.new("Frame", self.Window)
    container.BorderSizePixel = 0
    container.BackgroundColor3 = Theme.Background
    container.AutomaticSize = Enum.AutomaticSize.Y
    container.Size = UDim2.new(0, 100, 0, 0)
    container.Position = UDim2.new(0.19861, 0, 0.25732, 0)
    container.BorderColor3 = Color3.fromRGB(0, 0, 0)
    container.Name = "dropdown frame"
    
    createUIPadding(container, {Top = UDim.new(0, 5), Bottom = UDim.new(0, 5)})
    createStroke(container, Theme.AccentLight)
    
    local layout = createUIListLayout(container, Enum.FillDirection.Vertical, 5)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    
    local selected = Instance.new("TextButton", container)
    selected.BorderSizePixel = 0
    selected.TextSize = 14
    selected.TextColor3 = Theme.TextPrimary
    selected.BackgroundColor3 = Theme.Background
    selected.FontFace = Fonts.Jura
    selected.Size = UDim2.new(1, 0, 0, 16)
    selected.BorderColor3 = Color3.fromRGB(0, 0, 0)
    selected.Name = "selection"
    selected.Text = default or label
    
    local optionsList = {}
    local isOpen = false
    
    for _, option in ipairs(options) do
        local btn = Instance.new("TextButton", container)
        btn.BorderSizePixel = 0
        btn.TextSize = 14
        btn.TextColor3 = Theme.TextMuted
        btn.BackgroundColor3 = Theme.Background
        btn.FontFace = Fonts.Jura
        btn.Size = UDim2.new(1, 0, 0, 16)
        btn.BorderColor3 = Color3.fromRGB(0, 0, 0)
        btn.Name = "unselected"
        btn.Text = option
        btn.Visible = false
        
        btn.MouseButton1Click:Connect(function()
            selected.Text = option
            if callback then callback(option) end
            -- Close dropdown
            for _, b in ipairs(optionsList) do
                b.Visible = false
            end
            isOpen = false
        end)
        
        table.insert(optionsList, btn)
    end
    
    selected.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        for _, btn in ipairs(optionsList) do
            btn.Visible = isOpen
        end
        container.Size = UDim2.new(0, 100, 0, 0)
    end)
    
    return {
        SetSelected = function(option)
            selected.Text = option
            if callback then callback(option) end
        end,
        GetSelected = function() return selected.Text end,
    }
end

return UILibrary
