--[[
    Phantom Hook UI Library | Enhanced with Config System & Custom Hover Crosshair
--]]

local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Library = {}
Library.__index = Library

-- Design Tokens & Typography
local TWEEN_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local FONT_BOLD = Font.new("rbxasset://fonts/families/Sarpanch.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)
local FONT_REGULAR = Font.new("rbxasset://fonts/families/Sarpanch.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)

local COLOR_PRIMARY = Color3.fromRGB(29, 31, 35)
local COLOR_SECTION = Color3.fromRGB(25, 28, 31)
local COLOR_SURFACE = Color3.fromRGB(38, 39, 45)
local COLOR_TEXT_ACTIVE = Color3.fromRGB(255, 255, 255)
local COLOR_TEXT_INACTIVE = Color3.fromRGB(126, 125, 138)
local COLOR_ACCENT = Color3.fromRGB(152, 152, 168)
local COLOR_BORDER = Color3.fromRGB(57, 58, 66)

-- Helper: Dragging
local function makeDraggable(handle, frame)
	local dragging, dragInput, dragStart, startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			TweenService:Create(frame, TWEEN_INFO, {
				Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			}):Play()
		end
	end)
end

function Library.CreateWindow(titleText, configFileName)
	configFileName = configFileName or "PhantomHook_Config.json"

	local Window = {
		Tabs = {},
		CurrentTab = nil,
		Minimized = false,
		ConfigData = {},
		ConfigElements = {}
	}

	-- Root ScreenGui
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "PhantomHookUI_" .. math.random(1000, 9999)
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.ResetOnSpawn = false

	local localPlayer = Players.LocalPlayer or Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
	ScreenGui.Parent = localPlayer:WaitForChild("PlayerGui")

	-- Custom Hover Crosshair (Asset 10639770199)
	local CustomCrosshair = Instance.new("ImageLabel", ScreenGui)
	CustomCrosshair.Name = "CustomCrosshair"
	CustomCrosshair.BackgroundTransparency = 1
	CustomCrosshair.Size = UDim2.new(0, 32, 0, 32)
	CustomCrosshair.Image = "rbxassetid://10639770199"
	CustomCrosshair.ZIndex = 999
	CustomCrosshair.Visible = false
	CustomCrosshair.AnchorPoint = Vector2.new(0.5, 0.5)

	-- Main Window Frame
	local MainFrame = Instance.new("Frame", ScreenGui)
	MainFrame.Name = "Window"
	MainFrame.BackgroundColor3 = COLOR_PRIMARY
	MainFrame.BorderSizePixel = 0
	MainFrame.ClipsDescendants = false
	MainFrame.Size = UDim2.new(0, 520, 0, 305)
	MainFrame.Position = UDim2.new(0.5, -260, 0.5, -152)

	-- Hover Detection for Crosshair
	MainFrame.MouseEnter:Connect(function()
		CustomCrosshair.Visible = true
		UserInputService.MouseIconEnabled = false
	end)

	MainFrame.MouseLeave:Connect(function()
		CustomCrosshair.Visible = false
		UserInputService.MouseIconEnabled = true
	end)

	UserInputService.InputChanged:Connect(function(input)
		if CustomCrosshair.Visible and input.UserInputType == Enum.UserInputType.MouseMovement then
			CustomCrosshair.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y)
		end
	end)

	-- Top Bar
	local TopBar = Instance.new("Frame", MainFrame)
	TopBar.Name = "TopBar"
	TopBar.BackgroundTransparency = 1
	TopBar.BorderSizePixel = 0
	TopBar.Size = UDim2.new(1, 0, 0, 28)

	local TopBarPadding = Instance.new("UIPadding", TopBar)
	TopBarPadding.PaddingLeft = UDim.new(0, 10)
	TopBarPadding.PaddingRight = UDim.new(0, 10)

	local Title = Instance.new("TextLabel", TopBar)
	Title.Name = "Title"
	Title.BackgroundTransparency = 1
	Title.BorderSizePixel = 0
	Title.Size = UDim2.new(0.35, 0, 1, 0)
	Title.FontFace = FONT_BOLD
	Title.RichText = true
	Title.Text = titleText or [[Phantom <font color="rgb(77, 87, 122)">Hook</font>]]
	Title.TextColor3 = COLOR_TEXT_ACTIVE
	Title.TextSize = 14
	Title.TextXAlignment = Enum.TextXAlignment.Left

	-- Window Controls
	local WindowControls = Instance.new("Frame", TopBar)
	WindowControls.Name = "WindowControls"
	WindowControls.BackgroundTransparency = 1
	WindowControls.Size = UDim2.new(0, 32, 1, 0)
	WindowControls.Position = UDim2.new(1, -32, 0, 0)

	local ControlsLayout = Instance.new("UIListLayout", WindowControls)
	ControlsLayout.FillDirection = Enum.FillDirection.Horizontal
	ControlsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	ControlsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	ControlsLayout.Padding = UDim.new(0, 6)

	local MinBtn = Instance.new("TextButton", WindowControls)
	MinBtn.BackgroundTransparency = 1
	MinBtn.Size = UDim2.new(0, 12, 0, 12)
	MinBtn.FontFace = FONT_BOLD
	MinBtn.Text = "-"
	MinBtn.TextColor3 = COLOR_TEXT_INACTIVE
	MinBtn.TextSize = 14

	MinBtn.MouseButton1Click:Connect(function()
		Window.Minimized = not Window.Minimized
		TweenService:Create(MainFrame, TWEEN_INFO, {
			Size = Window.Minimized and UDim2.new(0, 520, 0, 28) or UDim2.new(0, 520, 0, 305)
		}):Play()
	end)

	local TabButtonsContainer = Instance.new("Frame", TopBar)
	TabButtonsContainer.Name = "TabButtons"
	TabButtonsContainer.BackgroundTransparency = 1
	TabButtonsContainer.Position = UDim2.new(0.35, 0, 0, 0)
	TabButtonsContainer.Size = UDim2.new(0.65, -36, 1, 0)

	local TabListLayout = Instance.new("UIListLayout", TabButtonsContainer)
	TabListLayout.FillDirection = Enum.FillDirection.Horizontal
	TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	TabListLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	TabListLayout.Padding = UDim.new(0, 16)
	TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder

	makeDraggable(TopBar, MainFrame)

	-- =========================================================================
	-- Config Engine
	-- =========================================================================
	function Window:SaveConfig()
		if not writefile then return end
		local encodedData = HttpService:JSONEncode(Window.ConfigData)
		writefile(configFileName, encodedData)
	end

	function Window:LoadConfig()
		if not (readfile and isfile and isfile(configFileName)) then return end
		local success, result = pcall(function()
			return HttpService:JSONDecode(readfile(configFileName))
		end)

		if success and type(result) == "table" then
			Window.ConfigData = result
			for id, value in pairs(Window.ConfigData) do
				if Window.ConfigElements[id] then
					Window.ConfigElements[id].Set(value)
				end
			end
		end
	end

	function Window:Destroy()
		UserInputService.MouseIconEnabled = true
		ScreenGui:Destroy()
	end

	-- Create Tab
	function Window:CreateTab(name)
		local Tab = { Sections = {} }

		local TabFrame = Instance.new("Frame", MainFrame)
		TabFrame.Name = name .. "_Tab"
		TabFrame.BackgroundTransparency = 1
		TabFrame.Position = UDim2.new(0, 0, 0, 28)
		TabFrame.Size = UDim2.new(1, 0, 1, -28)
		TabFrame.Visible = false

		local TabPadding = Instance.new("UIPadding", TabFrame)
		TabPadding.PaddingTop = UDim.new(0, 4)
		TabPadding.PaddingBottom = UDim.new(0, 10)
		TabPadding.PaddingLeft = UDim.new(0, 10)
		TabPadding.PaddingRight = UDim.new(0, 10)

		local TabContentLayout = Instance.new("UIListLayout", TabFrame)
		TabContentLayout.FillDirection = Enum.FillDirection.Horizontal
		TabContentLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
		TabContentLayout.VerticalFlex = Enum.UIFlexAlignment.Fill
		TabContentLayout.Padding = UDim.new(0, 8)
		TabContentLayout.SortOrder = Enum.SortOrder.LayoutOrder

		local TabBtn = Instance.new("TextButton", TabButtonsContainer)
		TabBtn.Name = name
		TabBtn.BackgroundTransparency = 1
		TabBtn.FontFace = FONT_BOLD
		TabBtn.Text = name:lower()
		TabBtn.TextSize = 13
		TabBtn.TextColor3 = COLOR_TEXT_INACTIVE
		TabBtn.AutomaticSize = Enum.AutomaticSize.X
		TabBtn.Size = UDim2.new(0, 0, 1, 0)

		local function activateTab()
			for _, t in pairs(Window.Tabs) do
				t.Frame.Visible = false
				TweenService:Create(t.Button, TWEEN_INFO, { TextColor3 = COLOR_TEXT_INACTIVE }):Play()
			end
			TabFrame.Visible = true
			TweenService:Create(TabBtn, TWEEN_INFO, { TextColor3 = COLOR_TEXT_ACTIVE }):Play()
			Window.CurrentTab = Tab
		end

		TabBtn.MouseButton1Click:Connect(activateTab)
		table.insert(Window.Tabs, { Frame = TabFrame, Button = TabBtn })

		if #Window.Tabs == 1 then
			activateTab()
		end

		-- Create Section
		function Tab:CreateSection()
			local Section = {}

			local SectionFrame = Instance.new("ScrollingFrame", TabFrame)
			SectionFrame.Name = "Section"
			SectionFrame.BackgroundColor3 = COLOR_SECTION
			SectionFrame.BorderSizePixel = 0
			SectionFrame.ScrollBarThickness = 2
			SectionFrame.ScrollBarImageColor3 = COLOR_BORDER
			SectionFrame.Size = UDim2.new(0, 100, 0, 100)
			SectionFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
			SectionFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y

			local Stroke = Instance.new("UIStroke", SectionFrame)
			Stroke.Color = COLOR_SURFACE
			Stroke.LineJoinMode = Enum.LineJoinMode.Miter

			local SectionPadding = Instance.new("UIPadding", SectionFrame)
			SectionPadding.PaddingTop = UDim.new(0, 8)
			SectionPadding.PaddingBottom = UDim.new(0, 8)
			SectionPadding.PaddingLeft = UDim.new(0, 8)
			SectionPadding.PaddingRight = UDim.new(0, 8)

			local SectionLayout = Instance.new("UIListLayout", SectionFrame)
			SectionLayout.HorizontalFlex = Enum.UIFlexAlignment.Fill
			SectionLayout.Padding = UDim.new(0, 10)
			SectionLayout.SortOrder = Enum.SortOrder.LayoutOrder

			function Section:AddSeparator()
				local Sep = Instance.new("Frame", SectionFrame)
				Sep.Name = "Separator"
				Sep.BackgroundColor3 = COLOR_BORDER
				Sep.BorderSizePixel = 0
				Sep.Size = UDim2.new(1, 0, 0, 1)
			end

			-- Toggle with Auto-Save
			function Section:AddToggle(text, default, callback)
				local configId = name .. "_" .. text
				local state = Window.ConfigData[configId] ~= nil and Window.ConfigData[configId] or (default or false)
				callback = callback or function() end

				local ToggleFrame = Instance.new("Frame", SectionFrame)
				ToggleFrame.Name = "Toggle"
				ToggleFrame.BackgroundTransparency = 1
				ToggleFrame.Size = UDim2.new(1, 0, 0, 18)

				local Layout = Instance.new("UIListLayout", ToggleFrame)
				Layout.FillDirection = Enum.FillDirection.Horizontal
				Layout.VerticalAlignment = Enum.VerticalAlignment.Center
				Layout.Padding = UDim.new(0, 10)

				local ToggleBtn = Instance.new("TextButton", ToggleFrame)
				ToggleBtn.Name = "ToggleButton"
				ToggleBtn.BorderSizePixel = 0
				ToggleBtn.Size = UDim2.new(0, 12, 0, 12)
				ToggleBtn.Text = ""
				ToggleBtn.BackgroundColor3 = state and COLOR_ACCENT or COLOR_SURFACE

				local Label = Instance.new("TextLabel", ToggleFrame)
				Label.BackgroundTransparency = 1
				Label.FontFace = FONT_REGULAR
				Label.Text = text
				Label.TextColor3 = COLOR_TEXT_ACTIVE
				Label.TextSize = 13
				Label.TextXAlignment = Enum.TextXAlignment.Left
				Label.Size = UDim2.new(1, -22, 1, 0)

				local function setToggle(val)
					state = val
					Window.ConfigData[configId] = state
					Window:SaveConfig()

					TweenService:Create(ToggleBtn, TWEEN_INFO, {
						BackgroundColor3 = state and COLOR_ACCENT or COLOR_SURFACE
					}):Play()
					task.spawn(pcall, callback, state)
				end

				ToggleBtn.MouseButton1Click:Connect(function()
					setToggle(not state)
				end)

				Window.ConfigElements[configId] = { Set = setToggle }
				return { Set = setToggle }
			end

			-- Keybind with Auto-Save
			function Section:AddKeybind(text, defaultKey, callback)
				local configId = name .. "_" .. text
				local savedKeyName = Window.ConfigData[configId]
				local currentKey = savedKeyName and Enum.KeyCode[savedKeyName] or (defaultKey or Enum.KeyCode.E)
				local listening = false
				callback = callback or function() end

				local KeyFrame = Instance.new("Frame", SectionFrame)
				KeyFrame.Name = "Keybind"
				KeyFrame.BackgroundTransparency = 1
				KeyFrame.Size = UDim2.new(1, 0, 0, 20)

				local Layout = Instance.new("UIListLayout", KeyFrame)
				Layout.FillDirection = Enum.FillDirection.Horizontal
				Layout.VerticalAlignment = Enum.VerticalAlignment.Center

				local Label = Instance.new("TextLabel", KeyFrame)
				Label.BackgroundTransparency = 1
				Label.FontFace = FONT_REGULAR
				Label.Text = text
				Label.TextColor3 = COLOR_TEXT_ACTIVE
				Label.TextSize = 13
				Label.TextXAlignment = Enum.TextXAlignment.Left
				Label.Size = UDim2.new(0.6, 0, 1, 0)

				local KeyBtn = Instance.new("TextButton", KeyFrame)
				KeyBtn.BackgroundColor3 = COLOR_SURFACE
				KeyBtn.BorderSizePixel = 0
				KeyBtn.FontFace = FONT_BOLD
				KeyBtn.Text = currentKey.Name
				KeyBtn.TextColor3 = COLOR_TEXT_ACTIVE
				KeyBtn.TextSize = 12
				KeyBtn.Size = UDim2.new(0.4, 0, 1, 0)

				local function setKey(key)
					currentKey = key
					KeyBtn.Text = currentKey.Name
					Window.ConfigData[configId] = currentKey.Name
					Window:SaveConfig()
				end

				KeyBtn.MouseButton1Click:Connect(function()
					listening = true
					KeyBtn.Text = "..."
				end)

				UserInputService.InputBegan:Connect(function(input, gpe)
					if listening then
						if input.UserInputType == Enum.UserInputType.Keyboard then
							setKey(input.KeyCode)
						end
						listening = false
					elseif not gpe and input.KeyCode == currentKey then
						task.spawn(pcall, callback, currentKey)
					end
				end)

				Window.ConfigElements[configId] = { Set = setKey }
			end

			-- Slider with Auto-Save
			function Section:AddSlider(text, min, max, default, callback)
				min = min or 0
				max = max or 100
				local configId = name .. "_" .. text
				local value = Window.ConfigData[configId] or math.clamp(default or min, min, max)
				callback = callback or function() end

				local SliderFrame = Instance.new("Frame", SectionFrame)
				SliderFrame.Name = "Slider"
				SliderFrame.BackgroundTransparency = 1
				SliderFrame.Size = UDim2.new(1, 0, 0, 32)

				local Layout = Instance.new("UIListLayout", SliderFrame)
				Layout.SortOrder = Enum.SortOrder.LayoutOrder

				local Label = Instance.new("TextLabel", SliderFrame)
				Label.BackgroundTransparency = 1
				Label.FontFace = FONT_BOLD
				Label.Text = text
				Label.TextColor3 = COLOR_TEXT_ACTIVE
				Label.TextSize = 13
				Label.TextXAlignment = Enum.TextXAlignment.Left
				Label.Size = UDim2.new(1, 0, 0, 14)

				local BarBg = Instance.new("Frame", SliderFrame)
				BarBg.Name = "SliderBG"
				BarBg.BackgroundColor3 = COLOR_SURFACE
				BarBg.BorderSizePixel = 0
				BarBg.Size = UDim2.new(1, 0, 0, 10)

				local Indicator = Instance.new("Frame", BarBg)
				Indicator.Name = "Indicator"
				Indicator.BackgroundColor3 = COLOR_ACCENT
				Indicator.BorderSizePixel = 0

				local ValueLabel = Instance.new("TextLabel", BarBg)
				ValueLabel.BackgroundTransparency = 1
				ValueLabel.FontFace = FONT_BOLD
				ValueLabel.TextColor3 = COLOR_TEXT_ACTIVE
				ValueLabel.TextSize = 11
				ValueLabel.Size = UDim2.new(1, 0, 1, 0)

				local function setSlider(val)
					value = math.clamp(val, min, max)
					Window.ConfigData[configId] = value
					Window:SaveConfig()

					local percent = (value - min) / (max - min)
					TweenService:Create(Indicator, TWEEN_INFO, { Size = UDim2.new(percent, 0, 1, 0) }):Play()
					ValueLabel.Text = tostring(value)
					task.spawn(pcall, callback, value)
				end

				local dragging = false
				local function updateFromInput(input)
					local percent = math.clamp((input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X, 0, 1)
					local val = math.floor(min + (max - min) * percent)
					setSlider(val)
				end

				BarBg.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						updateFromInput(input)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						updateFromInput(input)
					end
				end)

				setSlider(value)
				Window.ConfigElements[configId] = { Set = setSlider }
			end

			-- Dropdown with Auto-Save
			function Section:AddDropdown(options, default, callback)
				options = options or {}
				local textLabelName = "Dropdown_" .. (#SectionFrame:GetChildren())
				local configId = name .. "_" .. textLabelName
				local selected = Window.ConfigData[configId] or (default or options[1] or "Select...")
				callback = callback or function() end

				local DropFrame = Instance.new("Frame", SectionFrame)
				DropFrame.Name = "Dropdown"
				DropFrame.BackgroundTransparency = 1
				DropFrame.Size = UDim2.new(1, 0, 0, 20)

				local Header = Instance.new("Frame", DropFrame)
				Header.BackgroundColor3 = COLOR_SURFACE
				Header.BorderSizePixel = 0
				Header.Size = UDim2.new(1, 0, 1, 0)

				local DropBtn = Instance.new("TextButton", Header)
				DropBtn.BackgroundTransparency = 1
				DropBtn.FontFace = FONT_BOLD
				DropBtn.Text = selected
				DropBtn.TextColor3 = COLOR_TEXT_ACTIVE
				DropBtn.TextSize = 13
				DropBtn.Size = UDim2.new(1, -20, 1, 0)

				local Icon = Instance.new("ImageLabel", Header)
				Icon.BackgroundTransparency = 1
				Icon.Image = "rbxassetid://17253632400"
				Icon.Size = UDim2.new(0, 12, 0, 12)
				Icon.Position = UDim2.new(1, -15, 0.5, -6)

				local DropMenu = Instance.new("Frame", ScreenGui)
				DropMenu.Name = "DropdownMenu"
				DropMenu.BackgroundColor3 = COLOR_SURFACE
				DropMenu.BorderSizePixel = 0
				DropMenu.ClipsDescendants = true
				DropMenu.Size = UDim2.new(0, 0, 0, 0)
				DropMenu.Visible = false
				DropMenu.ZIndex = 30

				local MenuPadding = Instance.new("UIPadding", DropMenu)
				MenuPadding.PaddingTop = UDim.new(0, 4)
				MenuPadding.PaddingBottom = UDim.new(0, 4)

				local MenuLayout = Instance.new("UIListLayout", DropMenu)
				MenuLayout.Padding = UDim.new(0, 2)
				MenuLayout.SortOrder = Enum.SortOrder.LayoutOrder

				local function setOption(val)
					selected = val
					DropBtn.Text = selected
					Window.ConfigData[configId] = selected
					Window:SaveConfig()
					task.spawn(pcall, callback, selected)
				end

				local function refreshOptions()
					for _, item in pairs(DropMenu:GetChildren()) do
						if item:IsA("TextButton") then item:Destroy() end
					end

					for _, opt in ipairs(options) do
						local OptBtn = Instance.new("TextButton", DropMenu)
						OptBtn.BackgroundColor3 = COLOR_SURFACE
						OptBtn.BorderSizePixel = 0
						OptBtn.FontFace = FONT_BOLD
						OptBtn.Size = UDim2.new(1, 0, 0, 18)
						OptBtn.Text = opt
						OptBtn.TextSize = 12
						OptBtn.TextColor3 = (opt == selected) and COLOR_TEXT_ACTIVE or COLOR_TEXT_INACTIVE

						OptBtn.MouseButton1Click:Connect(function()
							setOption(opt)
							DropMenu.Visible = false
							refreshOptions()
						end)
					end
				end

				refreshOptions()

				DropBtn.MouseButton1Click:Connect(function()
					DropMenu.Visible = not DropMenu.Visible
					if DropMenu.Visible then
						local targetHeight = (#options * 20) + 8
						DropMenu.Position = UDim2.new(0, Header.AbsolutePosition.X, 0, Header.AbsolutePosition.Y + Header.AbsoluteSize.Y + 2)
						DropMenu.Size = UDim2.new(0, Header.AbsoluteSize.X, 0, 0)
						TweenService:Create(DropMenu, TWEEN_INFO, { Size = UDim2.new(0, Header.AbsoluteSize.X, 0, targetHeight) }):Play()
					end
				end)

				Window.ConfigElements[configId] = { Set = setOption }
				return { Set = setOption }
			end

			return Section
		end

		return Tab
	end

	-- Auto Load Settings on Execution
	task.spawn(function()
		Window:LoadConfig()
	end)

	return Window
end

return Library
