-- ArchNem UI Library
-- Converted from the supplied UI layout.
-- UI framework only: it does not implement gameplay/cheat functionality.

local Library = {}
Library.__index = Library

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

Library.Theme = {
    Background = Color3.fromRGB(25, 26, 26),
    Section = Color3.fromRGB(27, 28, 28),
    Border = Color3.fromRGB(52, 52, 51),
    Accent = Color3.fromRGB(29, 48, 52),
    Text = Color3.fromRGB(242, 242, 242),
    Muted = Color3.fromRGB(82, 84, 85),
    Off = Color3.fromRGB(30, 30, 30),
}

local function new(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function stroke(parent, color)
    return new("UIStroke", {
        Color = color or Library.Theme.Border,
        LineJoinMode = Enum.LineJoinMode.Miter,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

local function makeDraggable(frame, handle)
    local dragging, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and
           input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)
end

function Library:CreateWindow(options)
    options = options or {}

    local gui = new("ScreenGui", {
        Name = options.Name or "ArchNem",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, LocalPlayer:WaitForChild("PlayerGui"))

    local window = new("Frame", {
        Name = "Window",
        Size = UDim2.fromOffset(options.Width or 548, options.Height or 398),
        Position = UDim2.new(0.5, -(options.Width or 548)/2, 0.5, -(options.Height or 398)/2),
        BackgroundColor3 = Library.Theme.Background,
        BorderSizePixel = 0,
    }, gui)
    stroke(window, Library.Theme.Border)

    local top = new("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, window)

    local title = new("TextLabel", {
        Name = "Title",
        Size = UDim2.fromOffset(200, 26),
        Position = UDim2.fromOffset(9, 0),
        BackgroundTransparency = 1,
        Text = options.Title or "Arch.nem",
        TextColor3 = Library.Theme.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, top)

    local tabs = new("Frame", {
        Name = "Tabs",
        Size = UDim2.new(1, -220, 1, 0),
        Position = UDim2.fromOffset(215, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, top)

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 5),
    }, tabs)

    local content = new("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -20, 1, -36),
        Position = UDim2.fromOffset(10, 31),
        BackgroundColor3 = Library.Theme.Section,
        BorderSizePixel = 0,
    }, window)
    stroke(content, Library.Theme.Accent)

    local pages = {}
    local currentPage
    local windowObject = {
        Gui = gui,
        Window = window,
        Content = content,
        Tabs = tabs,
        Pages = pages,
    }

    function windowObject:SetTitle(text)
        title.Text = text
    end

    function windowObject:Toggle()
        gui.Enabled = not gui.Enabled
    end

    function windowObject:Destroy()
        gui:Destroy()
    end

    function windowObject:CreateTab(name)
        local page = {
            Name = name,
            Sections = {},
        }

        local tabButton = new("TextButton", {
            Name = name,
            Size = UDim2.fromOffset(70, 26),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = name,
            TextSize = 14,
            Font = Enum.Font.GothamBold,
            TextColor3 = Library.Theme.Muted,
            AutoButtonColor = false,
        }, tabs)

        local pageFrame = new("ScrollingFrame", {
            Name = name .. "Page",
            Size = UDim2.new(1, -18, 1, -18),
            Position = UDim2.fromOffset(9, 9),
            BackgroundColor3 = Library.Theme.Background,
            BorderSizePixel = 0,
            ScrollBarThickness = 0,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, content)

        new("UIPadding", {
            PaddingTop = UDim.new(0, 9),
            PaddingBottom = UDim.new(0, 9),
            PaddingLeft = UDim.new(0, 9),
            PaddingRight = UDim.new(0, 9),
        }, pageFrame)

        new("UIListLayout", {
            Padding = UDim.new(0, 10),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, pageFrame)

        page.Button = tabButton
        page.Frame = pageFrame
        table.insert(pages, page)

        local function select()
            for _, p in ipairs(pages) do
                p.Frame.Visible = false
                p.Button.TextColor3 = Library.Theme.Muted
            end
            page.Frame.Visible = true
            page.Button.TextColor3 = Library.Theme.Text
            currentPage = page
        end

        tabButton.MouseButton1Click:Connect(select)

        if not currentPage then
            select()
        end

        function page:CreateSection(sectionName)
            local section = {
                Name = sectionName,
                Elements = {},
            }

            local box = new("Frame", {
                Name = sectionName,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Library.Theme.Background,
                BorderSizePixel = 0,
            }, pageFrame)
            stroke(box, Library.Theme.Border)

            new("UIPadding", {
                PaddingTop = UDim.new(0, 9),
                PaddingBottom = UDim.new(0, 9),
                PaddingLeft = UDim.new(0, 9),
                PaddingRight = UDim.new(0, 9),
            }, box)

            new("UIListLayout", {
                Padding = UDim.new(0, 7),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, box)

            if sectionName and sectionName ~= "" then
                new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    Text = sectionName,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, box)
            end

            function section:AddToggle(toggleName, default, callback)
                local state = default == true

                local row = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 18),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                }, box)

                local indicator = new("Frame", {
                    Size = UDim2.fromOffset(12, 12),
                    Position = UDim2.fromOffset(0, 3),
                    BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Off,
                    BorderSizePixel = 0,
                }, row)
                stroke(indicator, Library.Theme.Border)

                local label = new("TextLabel", {
                    Size = UDim2.new(1, -20, 1, 0),
                    Position = UDim2.fromOffset(20, 0),
                    BackgroundTransparency = 1,
                    Text = toggleName,
                    TextColor3 = state and Library.Theme.Text or Library.Theme.Muted,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, row)

                local toggle = {}
                function toggle:Set(value)
                    state = value == true
                    indicator.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Off
                    label.TextColor3 = state and Library.Theme.Text or Library.Theme.Muted
                    if callback then callback(state) end
                end
                function toggle:Get()
                    return state
                end

                row.MouseButton1Click:Connect(function()
                    toggle:Set(not state)
                end)

                table.insert(section.Elements, toggle)
                return toggle
            end

            function section:AddButton(text, callback)
                local button = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = Library.Theme.Background,
                    BorderSizePixel = 0,
                    Text = text,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                }, box)
                stroke(button, Library.Theme.Accent)

                button.MouseEnter:Connect(function()
                    tween(button, TweenInfo.new(0.12), {BackgroundColor3 = Library.Theme.Section})
                end)
                button.MouseLeave:Connect(function()
                    tween(button, TweenInfo.new(0.12), {BackgroundColor3 = Library.Theme.Background})
                end)
                button.MouseButton1Click:Connect(function()
                    if callback then callback() end
                end)

                return button
            end

            function section:AddDropdown(text, values, default, callback)
                values = values or {}
                local current = default or values[1]

                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                }, box)

                local button = new("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundColor3 = Library.Theme.Background,
                    BorderSizePixel = 0,
                    Text = text .. ": " .. tostring(current or ""),
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                }, holder)
                stroke(button, Library.Theme.Accent)

                local popup = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 0),
                    Position = UDim2.new(0, 0, 1, 3),
                    BackgroundColor3 = Library.Theme.Background,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 20,
                }, holder)
                stroke(popup, Library.Theme.Accent)

                local list = new("UIListLayout", {
                    Padding = UDim.new(0, 2),
                }, popup)

                local dropdown = {}

                local function rebuild()
                    for _, child in ipairs(popup:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for _, value in ipairs(values) do
                        local option = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 20),
                            BackgroundColor3 = Library.Theme.Background,
                            BorderSizePixel = 0,
                            Text = tostring(value),
                            TextColor3 = value == current and Library.Theme.Text or Library.Theme.Muted,
                            TextSize = 14,
                            Font = Enum.Font.GothamBold,
                            ZIndex = 21,
                        }, popup)
                        option.MouseButton1Click:Connect(function()
                            current = value
                            button.Text = text .. ": " .. tostring(current)
                            popup.Visible = false
                            if callback then callback(current) end
                        end)
                    end
                    popup.Size = UDim2.new(1, 0, 0, #values * 22 + 4)
                end

                button.MouseButton1Click:Connect(function()
                    popup.Visible = not popup.Visible
                    if popup.Visible then rebuild() end
                end)

                function dropdown:Set(value)
                    current = value
                    button.Text = text .. ": " .. tostring(current)
                    if callback then callback(current) end
                end
                function dropdown:Get()
                    return current
                end

                return dropdown
            end

            function section:AddSlider(text, min, max, default, callback)
                min, max = min or 0, max or 100
                local value = math.clamp(default or min, min, max)

                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                }, box)

                new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, holder)

                local bar = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 15),
                    Position = UDim2.fromOffset(0, 20),
                    BackgroundColor3 = Library.Theme.Background,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                }, holder)
                stroke(bar, Library.Theme.Accent)

                local fill = new("Frame", {
                    Size = UDim2.new((value-min)/(max-min), 0, 1, 0),
                    BackgroundColor3 = Library.Theme.Accent,
                    BorderSizePixel = 0,
                }, bar)

                local valueLabel = new("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(value),
                    TextColor3 = Library.Theme.Text,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    ZIndex = 2,
                }, bar)

                local slider = {}
                local dragging = false

                local function setValueFromX(x)
                    local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    value = min + (max - min) * pct
                    value = math.floor(value * 100 + 0.5) / 100
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    if callback then callback(value) end
                end

                bar.MouseButton1Down:Connect(function(x)
                    dragging = true
                    setValueFromX(x)
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        setValueFromX(input.Position.X)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)

                function slider:Set(v)
                    value = math.clamp(v, min, max)
                    local pct = (value-min)/(max-min)
                    fill.Size = UDim2.new(pct, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    if callback then callback(value) end
                end
                function slider:Get()
                    return value
                end

                return slider
            end

            function section:AddKeybind(text, default, callback)
                local current = default or Enum.KeyCode.Unknown

                local row = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                }, box)

                new("TextLabel", {
                    Size = UDim2.new(1, -105, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, row)

                local button = new("TextButton", {
                    Size = UDim2.fromOffset(100, 24),
                    Position = UDim2.new(1, -100, 0, 0),
                    BackgroundColor3 = Library.Theme.Background,
                    BorderSizePixel = 0,
                    Text = current.Name,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                }, row)
                stroke(button, Library.Theme.Accent)

                local listening = false
                button.MouseButton1Click:Connect(function()
                    listening = true
                    button.Text = "Press key..."
                end)

                local connection = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed or not listening then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        current = input.KeyCode
                        listening = false
                        button.Text = current.Name
                        if callback then callback(current) end
                    end
                end)

                local bind = {}
                function bind:Set(key)
                    current = key
                    button.Text = key.Name
                    if callback then callback(key) end
                end
                function bind:Get()
                    return current
                end
                function bind:Destroy()
                    connection:Disconnect()
                    row:Destroy()
                end

                return bind
            end

            table.insert(page.Sections, section)
            return section
        end

        return page
    end

    makeDraggable(window, top)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if options.ToggleKey and input.KeyCode == options.ToggleKey then
            gui.Enabled = not gui.Enabled
        end
    end)

    return windowObject
end

return Library
