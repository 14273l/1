			TextColor3 = RGB(255,255,255),
			Text = title,
			TextStrokeTransparency = 0,
			Size = UFS(0.884,1),
			BackgroundTransparency = 1,
			TextXAlignment = TXA.Left,
			BorderSizePixel = 0,
			TextYAlignment = TYA.Top,
			TextSize = 14,
			BackgroundColor3 = RGB(255,255,255),
		})

		-- State
		local state = default
		local function updateToggle(val)
			state = val
			if val then
				toggleBtn.BackgroundColor3 = STYLE.AccentDim
				-- add shadow
				local shadow = addShadow(toggleBtn, 10, STYLE.Accent, 0.5, UFO(0,2))
				-- store shadow reference to remove later? we'll just recreate
				-- simplify: we'll keep it simple
				-- we'll add shadow when on, remove when off
				local existing = toggleBtn:FindFirstChild("UIShadow")
				if existing then existing:Destroy() end
				if val then
					addShadow(toggleBtn, 10, STYLE.Accent, 0.5, UFO(0,2))
				end
			else
				toggleBtn.BackgroundColor3 = STYLE.BgColor
				local existing = toggleBtn:FindFirstChild("UIShadow")
				if existing then existing:Destroy() end
			end
			callback(val)
		end

		updateToggle(default)

		toggleBtn.MouseButton1Click:Connect(function()
			updateToggle(not state)
		end)

		local control = {}
		function control:SetValue(val)
			updateToggle(val)
		end
		function control:GetValue()
			return state
		end
		return control
	end

	-- Internal: create dropdown control
	function self:CreateDropdown(cfg, parent)
		cfg = cfg or {}
		local title = cfg.Title or "Dropdown"
		local options = cfg.Options or {"Option 1", "Option 2"}
		local default = cfg.Default or options[1]
		local callback = cfg.Callback or function() end

		local container = create("Frame", {
			Parent = parent,
			Name = "dropdown",
			BackgroundTransparency = 1,
			Size = UD2(0.4646,0,0,16),
			BorderColor3 = RGB(0,0,0),
			BorderSizePixel = 0,
			BackgroundColor3 = RGB(255,255,255),
		})
		addPadding(container, 0,0,5,0)
		addStroke(container, STYLE.BorderColor, 1, ASM.Border)
		addStroke(container, STYLE.BorderColor, 1, ASM.Border, 1)

		-- Arrow image
		local arrow = create("ImageLabel", {
			Parent = container,
			ImageColor3 = RGB(254,253,255),
			BorderColor3 = RGB(0,0,0),
			Image = "rbxassetid://15554886440",
			BackgroundTransparency = 1,
			Position = UD2(0.895, 0, -0.455, 2),
			Size = UFO(25,25),
			BorderSizePixel = 0,
			BackgroundColor3 = RGB(255,255,255),
		})

		-- Text button (clickable)
		local btn = create("TextButton", {
			Parent = container,
			FontFace = STYLE.FontBold,
			TextColor3 = RGB(255,255,255),
			Text = default,
			TextStrokeTransparency = 0,
			BackgroundTransparency = 1,
			TextXAlignment = TXA.Left,
			Size = UFO(195,15),
			BorderSizePixel = 0,
			TextSize = 13,
			BackgroundColor3 = RGB(255,255,255),
		})

		-- State
		local selected = default
		local function updateDropdown(val)
			selected = val
			btn.Text = val
			callback(val)
			-- Close overlay if open
			if self._dropdownOpen then
				self._dropdownOverlay.Visible = false
				self._dropdownOpen = false
				self._dropdownTarget = nil
			end
		end

		-- Dropdown overlay population
		local function openDropdown()
			if self._dropdownOpen then
				self._dropdownOverlay.Visible = false
				self._dropdownOpen = false
				return
			end
			-- Clear old options
			for _, child in ipairs(self._dropdownOverlay:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			-- Add options
			for _, opt in ipairs(options) do
				local isSelected = (opt == selected)
				local optBtn = create("TextButton", {
					Parent = self._dropdownOverlay,
					FontFace = STYLE.FontBold,
					TextColor3 = isSelected and STYLE.Accent or RGB(112,113,114),
					Text = opt,
					BackgroundTransparency = 1,
					Name = isSelected and "selection" or "unselected",
					Size = UD2(1,0,0,16),
					BorderSizePixel = 0,
					TextSize = 13,
					BackgroundColor3 = STYLE.BgColor,
				})
				optBtn.MouseButton1Click:Connect(function()
					updateDropdown(opt)
				end)
			end
			-- Position overlay relative to container
			local absPos = container.AbsolutePosition
			local absSize = container.AbsoluteSize
			self._dropdownOverlay.Position = UD2(0, absPos.X - self._window.AbsolutePosition.X, 0, absPos.Y + absSize.Y - self._window.AbsolutePosition.Y)
			self._dropdownOverlay.Visible = true
			self._dropdownOpen = true
			self._dropdownTarget = container
		end

		btn.MouseButton1Click:Connect(openDropdown)

		local control = {}
		function control:SetValue(val)
			if TF(options, val) then
				updateDropdown(val)
			end
		end
		function control:GetValue()
			return selected
		end
		return control
	end

	-- Close dropdown on click outside (simplified: global click on window)
	self._window.MouseButton1Down:Connect(function()
		if self._dropdownOpen then
			self._dropdownOverlay.Visible = false
			self._dropdownOpen = false
		end
	end)

	return self
end

