	-- Method to create a tab
	function self:CreateTab(name)
		-- Tab button
		local button = create("TextButton", {
			Parent = self._tabButtons,
			FontFace = STYLE.FontBody,
			TextColor3 = STYLE.TextGray,
			Text = name,
			TextStrokeTransparency = 0,
			Name = "unselected_tab",
			BackgroundTransparency = 1,
			Size = UFS(0,1),
			BorderSizePixel = 0,
			AutomaticSize = AS.X,
			TextSize = 14,
			BackgroundColor3 = RGB(255,255,255),
		})
		addPadding(button, 0,0,8,8)
		addStroke(button, STYLE.BorderColor, 1, ASM.Border, -2)

		-- Tab content (ScrollingFrame)
		local tabContent = create("ScrollingFrame", {
			Parent = self._contentFrame,
			ScrollBarImageColor3 = RGB(0,0,0),
			Active = true,
			AutomaticCanvasSize = AS.Y,
			ScrollBarThickness = 0,
			BackgroundTransparency = 1,
			Size = UFS(1,1),
			BackgroundColor3 = RGB(255,255,255),
			BorderColor3 = RGB(0,0,0),
			BorderSizePixel = 0,
			CanvasSize = UFS(0,0),
			Visible = false, -- initially hidden
		})
		addPadding(tabContent, 1,1,1,1)
		local tabLayout = addListLayout(tabContent, FD.Vertical, 8, SO.LayoutOrder)

		-- Store
		local tab = {
			Name = name,
			Button = button,
			Content = tabContent,
			Sections = {},
			Layout = tabLayout,
		}
		table.insert(self._tabs, tab)

		-- Click to switch
		button.MouseButton1Click:Connect(function()
			self:SelectTab(tab)
		end)

		-- If first tab, select it
		if #self._tabs == 1 then
			self:SelectTab(tab)
		end

		-- Return an interface to add sections
		local tabObj = {}
		function tabObj:CreateSection(title)
			local section = self:CreateSection(title, tabContent)
			return section
		end
		return tabObj
	end

	-- Internal: select tab
	function self:SelectTab(tab)
		if self._activeTab == tab then return end
		-- Update button styles
		for _, t in ipairs(self._tabs) do
			local isActive = (t == tab)
			t.Button.TextColor3 = isActive and STYLE.AccentDim or STYLE.TextGray
			t.Button.Name = isActive and "selected_tab" or "unselected_tab"
			-- Optionally add stroke highlight? We'll just change color.
			t.Content.Visible = isActive
		end
		self._activeTab = tab
	end

	-- Internal: create a section inside a tab content
	function self:CreateSection(title, parent)
		local section = create("Frame", {
			Parent = parent,
			Name = "section",
			Size = UFS(1,0),
			BorderColor3 = RGB(0,0,0),
			BorderSizePixel = 0,
			AutomaticSize = AS.Y,
			BackgroundColor3 = STYLE.BgColor,
		})
		addPadding(section, 12,12,12,12)
		addStroke(section, STYLE.BorderColor, 1, ASM.Border, nil, BSP.Inner)
		addStroke(section, STYLE.BorderColor, 2, ASM.Border, 1, BSP.Inner)
		local sectionLayout = addListLayout(section, FD.Vertical, 8, SO.LayoutOrder, UFA.Fill, nil, Enum.VerticalAlignment.Top)
		create("UIGradient", {
			Parent = section,
			Rotation = 90,
			Color = makeGradient({
				{0, RGB(255,255,255)},
				{1, RGB(200,200,200)},
			}),
		})

		-- Return a section object with methods to add controls
		local secObj = {}
		function secObj:CreateSlider(cfg)
			return self:CreateSlider(cfg, section)
		end
		function secObj:CreateToggle(cfg)
			return self:CreateToggle(cfg, section)
		end
		function secObj:CreateDropdown(cfg)
			return self:CreateDropdown(cfg, section)
		end
		return secObj
	end

	-- Internal: create slider control
	function self:CreateSlider(cfg, parent)
		cfg = cfg or {}
		local title = cfg.Title or "Slider"
		local min = cfg.Min or 0
		local max = cfg.Max or 100
		local default = cfg.Default or 50
		local callback = cfg.Callback or function() end

		local container = create("Frame", {
			Parent = parent,
			Name = "silder",
			BackgroundTransparency = 1,
			Size = UD2(1,0,0,16),
			BorderColor3 = RGB(0,0,0),
			BorderSizePixel = 0,
			AutomaticSize = AS.Y,
			BackgroundColor3 = RGB(255,255,255),
		})
		addPadding(container, 0,0,0,0)
		local cLayout = addListLayout(container, FD.Vertical, 4, SO.LayoutOrder)

		-- Title
		local titleLabel = create("TextLabel", {
			Parent = container,
			FontFace = STYLE.FontBold,
			TextColor3 = RGB(255,255,255),
			Text = title,
			TextStrokeTransparency = 0,
			Name = "Title",
			Size = UFO(205, 15),
			BackgroundTransparency = 1,
			TextXAlignment = TXA.Left,
			BorderSizePixel = 0,
			TextYAlignment = TYA.Top,
			TextSize = 14,
			BackgroundColor3 = RGB(255,255,255),
		})

		-- Slider base
		local sliderBase = create("Frame", {
			Parent = container,
			Name = "silder base",
			LayoutOrder = 999,
			BorderColor3 = RGB(0,0,0),
			BackgroundTransparency = 1,
			Size = UD2(1,0,0,13),
			BorderSizePixel = 0,
			BackgroundColor3 = RGB(255,255,255),
		})
		addStroke(sliderBase, STYLE.BorderColor, 1, ASM.Border)
		addStroke(sliderBase, STYLE.BorderColor, 1, ASM.Border, 1)

		-- Fill bar
		local fill = create("Frame", {
			Parent = sliderBase,
			BorderColor3 = RGB(0,0,0),
			Size = UFS(0.5,1), -- will be updated
			BorderSizePixel = 0,
			BackgroundColor3 = STYLE.AccentDim,
		})
		addShadow(fill, 4, STYLE.Accent, 0.5)

		-- Value label
		local valueLabel = create("TextLabel", {
			Parent = sliderBase,
			FontFace = STYLE.FontBold,
			TextColor3 = RGB(255,255,255),
			Text = tostring(default).."px",
			TextStrokeTransparency = 0,
			BackgroundTransparency = 1,
			Size = UFO(200, 13),
			BorderSizePixel = 0,
			TextSize = 14,
			BackgroundColor3 = RGB(255,255,255),
		})

		-- State
		local sliderData = {
			Min = min,
			Max = max,
			Value = default,
			Fill = fill,
			Label = valueLabel,
			Callback = callback,
		}

		-- Update UI
		local function updateValue(val)
			val = MC(val, min, max)
			sliderData.Value = val
			local percent = (val - min) / (max - min)
			fill.Size = UD2(percent, 0, 1, 0)
			valueLabel.Text = tostring(MR(val)).."px"
			callback(val)
		end
		updateValue(default)

		-- Mouse interaction
		local dragging = false
		local function onInput(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = true
			end
		end
		local function onInputEnd(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				dragging = false
			end
		end
		local function onMouseMove(input)
			if not dragging then return end
			local pos = input.Position.X
			local rel = pos - sliderBase.AbsolutePosition.X
			local width = sliderBase.AbsoluteSize.X
			local p = MC(rel / width, 0, 1)
			local val = min + (max - min) * p
			updateValue(val)
		end

		sliderBase.InputBegan:Connect(onInput)
		sliderBase.InputEnded:Connect(onInputEnd)
		sliderBase.MouseMoved:Connect(function(x, y)
			if dragging then
				local pos = x
				local rel = pos - sliderBase.AbsolutePosition.X
				local width = sliderBase.AbsoluteSize.X
				local p = MC(rel / width, 0, 1)
				local val = min + (max - min) * p
				updateValue(val)
			end
		end)

		-- Return control object
		local control = {}
		function control:SetValue(val)
			updateValue(val)
		end
		function control:GetValue()
			return sliderData.Value
		end
		return control
	end

