-- ------------------------------------------------------------------------
-- Utilities for creating styled elements (internal)
-- ------------------------------------------------------------------------
local function makeGradient(colors)
	-- colors: array of {position, Color3}
	local kps = {}
	for _, c in ipairs(colors) do
		table.insert(kps, CSK(c[1], c[2]))
	end
	return CS(unpack(kps))
end

local function addShadow(parent, blur, color, transparency, spread)
	spread = spread or UFO(0,0)
	local shadow = create("UIShadow", {
		Parent = parent,
		Transparency = transparency or 0.5,
		BlurRadius = UD(0, blur or 20),
		Color = color or STYLE.Accent,
		Spread = spread,
	})
	return shadow
end

local function addStroke(parent, color, thickness, mode, offset, position)
	local props = {
		Parent = parent,
		Color = color or STYLE.BorderColor,
		LineJoinMode = Enum.LineJoinMode.Miter,
		ApplyStrokeMode = mode or ASM.Border,
	}
	if thickness then props.Thickness = thickness end
	if offset then props.BorderOffset = UD(0, offset) end
	if position then props.BorderStrokePosition = position end
	return create("UIStroke", props)
end

local function addPadding(parent, top, bottom, left, right)
	return create("UIPadding", {
		Parent = parent,
		PaddingTop = UD(0, top or 0),
		PaddingBottom = UD(0, bottom or 0),
		PaddingLeft = UD(0, left or 0),
		PaddingRight = UD(0, right or 0),
	})
end

local function addListLayout(parent, direction, padding, sort, hflex, vflex, valign)
	return create("UIListLayout", {
		Parent = parent,
		FillDirection = direction or FD.Vertical,
		Padding = UD(0, padding or 0),
		SortOrder = sort or SO.LayoutOrder,
		HorizontalFlex = hflex or UFA.Fill,
		VerticalFlex = vflex or UFA.Fill,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
	})
end

local function makeHighlight(parent, colors, size)
	local h = create("Frame", {
		Parent = parent,
		Name = "highlight",
		BorderColor3 = RGB(0,0,0),
		Size = size or UD2(1,0,0,1),
		BorderSizePixel = 0,
		BackgroundColor3 = RGB(255,255,255),
	})
	create("UIGradient", {
		Parent = h,
		Color = makeGradient(colors or {
			{0, RGB(18,18,18)},
			{0.25, STYLE.Accent},
			{0.5, RGB(18,18,18)},
			{0.75, STYLE.Accent},
			{1, RGB(18,18,18)},
		}),
	})
	return h
end

