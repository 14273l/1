--[[
	UI Library – based on the Vergil.lol design.
	Provides: Window, Tab, Section, Slider, Toggle, Dropdown.
	Usage example:
		local UI = require(script.Parent.UI)
		local main = UI:CreateWindow({
			Title = "My Menu",
			Parent = game.Players.LocalPlayer.PlayerGui,
			Size = UDim2.new(0, 498, 0, 598),
		})
		local aimTab = main:CreateTab("Aimbot")
		local general = aimTab:CreateSection("General")
		general:CreateSlider({
			Title = "Sensitivity",
			Min = 0, Max = 100, Default = 50,
			Callback = function(v) print(v) end
		})
		general:CreateToggle({
			Title = "Enabled",
			Default = true,
			Callback = function(v) print(v) end
		})
		general:CreateDropdown({
			Title = "Mode",
			Options = {"Option A", "Option B"},
			Default = "Option A",
			Callback = function(v) print(v) end
		})
--]]

local UI = {}
UI.__index = UI

-- ------------------------------------------------------------------------
-- Helpers (same as original)
-- ------------------------------------------------------------------------
local function create(class: string, properties: {}?): Instance | boolean
	local success, instance = pcall(Instance.new, class)
	if not success then return false end
	if properties then
		for key, value in next, properties do
			local succ, err = pcall(function()
				(instance :: any)[key] = value
			end)
			if not succ then
				warn(err)
				return false
			end
		end
	end
	return instance
end

